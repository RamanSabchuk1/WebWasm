<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.3" />
		<!-- Reference implementation: JwtReader must read claims exactly like the package the app used before -->
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
		<!-- Reference implementation: StorageFormat must stay compatible with values saved by Blazored -->
		<PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
	</ItemGroup>

	<!-- Pure logic from the app is linked as source: the app itself is browser-wasm and cannot be referenced -->
	<ItemGroup>
		<Compile Include="..\WebWasm\Helpers\JwtReader.cs" Link="Linked\JwtReader.cs" />
		<Compile Include="..\WebWasm\Helpers\StorageFormat.cs" Link="Linked\StorageFormat.cs" />
		<Compile Include="..\WebWasm\Services\LoadingService.cs" Link="Linked\LoadingService.cs" />
		<Compile Include="..\WebWasm\Services\EncryptionService.cs" Link="Linked\EncryptionService.cs" />
		<Compile Include="..\WebWasm\Helpers\SlotHelper.cs" Link="Linked\SlotHelper.cs" />
		<Compile Include="..\WebWasm\Models\BaseModels.cs" Link="Linked\BaseModels.cs" />
		<Compile Include="..\WebWasm\Models\PricingSettingModels.cs" Link="Linked\PricingSettingModels.cs" />
		<Compile Include="..\WebWasm\Models\SecurityModels.cs" Link="Linked\SecurityModels.cs" />
		<Compile Include="..\WebWasm\Helpers\PriceChartMath.cs" Link="Linked\PriceChartMath.cs" />
		<Compile Include="..\WebWasm\Localization\Texts.cs" Link="Linked\Texts.cs" />
		<Compile Include="..\WebWasm\Localization\Texts.Pricing.cs" Link="Linked\Texts.Pricing.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
