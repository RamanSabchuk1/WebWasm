@inherits LayoutComponentBase

<AuthorizeView>
	<Authorized>
		<div class="shell">
			<aside class="sidebar">
				<NavMenu />
			</aside>

			<header class="top-header">
				<a class="brand" href="">
					<img class="brand-logo" src="logo.svg" alt="" />
					<span class="brand-name">Kliffort</span>
					@if (Settings.EnvironmentLabel is { } label)
					{
						<span class="badge badge-accent">@label</span>
					}
				</a>
				<NavLink class="btn btn-ghost btn-icon" href="myuserinfo" title="@T.Shell.Profile" aria-label="@T.Shell.Profile">
					<Icon Name="IconName.User" Size="20" />
				</NavLink>
			</header>

			<main class="main">
				<div class="content">
					@Body
				</div>
			</main>

			<nav class="bottom-nav">
				<NavMenu IsMobile="true" />
			</nav>
		</div>
	</Authorized>
	<NotAuthorized>
		<Login />
	</NotAuthorized>
</AuthorizeView>
