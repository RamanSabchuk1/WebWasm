@if (!IsMobile)
{
	<div class="nav">
		<a class="nav-brand" href="">
			<img class="nav-logo" src="logo.svg" alt="" />
			<span class="nav-brand-name">@T.Shell.AppName</span>
			@if (Settings.EnvironmentLabel is { } label)
			{
				<span class="badge badge-accent">@label</span>
			}
		</a>

		@foreach (var group in Groups)
		{
			<div class="nav-group" @key="group.Key">
				<span class="nav-group-title">@group.Title(T.Shell)</span>
				@foreach (var item in group.Items)
				{
					<NavLink class="nav-item" href="@item.Href" Match="@item.Match" @key="item.Href">
						<Icon Name="item.Icon" Size="20" />
						<span>@item.Title(T.Shell)</span>
					</NavLink>
				}
			</div>
		}

		<div class="nav-footer">
			<PreferenceSwitches Compact="true" />
			<NavLink class="nav-item" href="myuserinfo">
				<Icon Name="IconName.User" Size="20" />
				<span>@T.Shell.Profile</span>
			</NavLink>
			<NavLink class="nav-item" href="logs">
				<Icon Name="IconName.Logs" Size="20" />
				<span>@T.Shell.Logs</span>
			</NavLink>
			<button type="button" class="nav-item" @onclick="Logout">
				<Icon Name="IconName.Logout" Size="20" />
				<span>@T.Shell.Logout</span>
			</button>
			<span class="nav-version">@T.Shell.Version(AppSettings.Version)</span>
		</div>
	</div>
}
else
{
	<div class="tabs">
		@foreach (var item in Tabs)
		{
			<NavLink class="tab" href="@item.Href" Match="@item.Match" @key="item.Href">
				<Icon Name="item.Icon" Size="20" />
				<span>@item.Title(T.Shell)</span>
			</NavLink>
		}
		<button type="button" class="tab @(_moreOpen ? "active" : null)" @onclick="ToggleMore" aria-expanded="@Aria.State(_moreOpen)">
			<Icon Name="IconName.Menu" Size="20" />
			<span>@T.Shell.More</span>
		</button>
	</div>

	@if (_moreOpen)
	{
		<div class="sheet-overlay" @onclick="ToggleMore">
			<div class="sheet" @onclick:stopPropagation="true">
				<div class="sheet-header">
					<span class="card-title">@T.Shell.Menu</span>
					<button type="button" class="btn btn-ghost btn-icon" @onclick="ToggleMore" title="@T.Common.Close" aria-label="@T.Common.Close">
						<Icon Name="IconName.Close" Size="20" />
					</button>
				</div>
				<nav class="sheet-list">
					@foreach (var item in MoreItems)
					{
						<NavLink class="nav-item" href="@item.Href" Match="@item.Match" @onclick="ToggleMore" @key="item.Href">
							<Icon Name="item.Icon" Size="20" />
							<span>@item.Title(T.Shell)</span>
						</NavLink>
					}
				</nav>
				<PreferenceSwitches />
				<button type="button" class="nav-item" @onclick="Logout">
					<Icon Name="IconName.Logout" Size="20" />
					<span>@T.Shell.Logout</span>
				</button>
				<span class="nav-version">@T.Shell.Version(AppSettings.Version)</span>
			</div>
		</div>
	}
}
