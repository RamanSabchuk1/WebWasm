@page "/pricing-settings"

<AppTitle Text="@T.Shell.PricingSettings" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.PricingSettings</h1>
			<p class="page-subtitle">@T.Pricing.Subtitle</p>
		</div>
	</div>

	<div class="segmented page-tabs" role="group" aria-label="@T.Pricing.TabsLabel">
		<button type="button" aria-pressed="@Aria.State(_tab == Tab.Settings)" @onclick="() => _tab = Tab.Settings">
			<Icon Name="IconName.Settings" />
			@T.Pricing.TabSettings
		</button>
		<button type="button" aria-pressed="@Aria.State(_tab == Tab.Simulator)" @onclick="() => _tab = Tab.Simulator">
			<Icon Name="IconName.Chart" />
			@T.Pricing.TabSimulator
		</button>
	</div>

	@if (_tab == Tab.Simulator)
	{
		<PricingSimulator />
	}
	else
	{
		<div class="card">
			<div class="toolbar">
				<div class="segmented scope-switch" role="group" aria-label="@T.Pricing.ScopeLabel">
					@foreach (var scope in Scopes)
					{
						<button type="button" @key="scope" aria-pressed="@Aria.State(_scope == scope)" @onclick="() => ChangeScope(scope)">@T.Pricing.ScopeName(scope)</button>
					}
				</div>
				@if (_scope == ScopeCompany)
				{
					<div class="scope-picker">
						<select value="@(_companyId?.ToString() ?? "")" @onchange="OnCompanyChanged" aria-label="@T.Pricing.ScopeName(ScopeCompany)">
							<option value="">@T.Pricing.ChooseCompany</option>
							@foreach (var company in _companies)
							{
								<option value="@company.Id" @key="company.Id">@company.Name</option>
							}
						</select>
					</div>
				}
				else if (_scope == ScopeMaterialType)
				{
					<div class="scope-picker">
						<select value="@(_materialTypeId?.ToString() ?? "")" @onchange="OnMaterialTypeChanged" aria-label="@T.Pricing.ScopeName(ScopeMaterialType)">
							<option value="">@T.Pricing.ChooseMaterialType</option>
							@foreach (var materialType in _materialTypes)
							{
								<option value="@materialType.Id" @key="materialType.Id">@materialType.Name</option>
							}
						</select>
					</div>
				}
			</div>

			@if (_scope != ScopeGlobal && _scopeId is null)
			{
				<div class="empty">
					<Icon Name="@(_scope == ScopeCompany ? IconName.Companies : IconName.Materials)" />
					<p class="empty-title">@(_scope == ScopeCompany ? T.Pricing.ChooseCompany : T.Pricing.ChooseMaterialType)</p>
					<p class="empty-hint">@(_scope == ScopeCompany ? T.Pricing.ChooseCompanyHint : T.Pricing.ChooseMaterialTypeHint)</p>
				</div>
			}
			else if (_items.Count == 0)
			{
				<div class="empty">
					<Icon Name="IconName.Pricing" />
					<p class="empty-title">@T.Pricing.Empty</p>
					<p class="empty-hint">@T.Pricing.EmptyHint</p>
				</div>
			}
			else
			{
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th>@T.Pricing.Key</th>
								<th>@T.Common.Description</th>
								<th class="num">@T.Pricing.Default</th>
								<th class="num">@T.Pricing.RangeColumn</th>
								<th>@T.Pricing.CompanyEffectColumn</th>
								<th class="num">@T.Pricing.OverrideColumn(T.Pricing.ScopeName(_scope))</th>
								<th class="num">@T.Pricing.Effective</th>
								<th>@T.Common.Updated</th>
								<th><span class="visually-hidden">@T.Common.Actions</span></th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in _items)
							{
								// На уровне компании подсвечиваем ключи, значение которых ни на что не влияет.
								var useless = _scope == ScopeCompany && item.CompanyRoles is [];
								<tr @key="item.Key">
									<td><code>@item.Key</code></td>
									<td class="description">@item.Description</td>
									<td class="num nowrap">@(item.Default is { } defaultValue ? T.Pricing.Number(defaultValue) : Texts.Dash)</td>
									<td class="num nowrap">@T.Pricing.Range(item.Min, item.Max)</td>
									<td class="@(useless ? "warning-text" : null)">@(CompanyEffect(item) ?? Texts.Dash)</td>
									<td class="num nowrap">
										@if (item.OverrideValue is { } overrideValue)
										{
											<span class="strong">@T.Pricing.Number(overrideValue)</span>
										}
										else
										{
											<span class="muted">@T.Pricing.Inherited</span>
										}
									</td>
									<td class="num nowrap">
										@if (item.EffectiveValue is { } effective)
										{
											@T.Pricing.Number(effective)
										}
										else
										{
											<span class="muted">@T.Pricing.NotSet</span>
										}
									</td>
									<td class="tabular nowrap">@T.FormatDateTime(item.Updated?.ToLocalTime())</td>
									<td class="num">
										<ActionsDropdown MenuHeight="90">
											<button type="button" class="menu-item" @onclick="() => OpenEditDialog(item)">
												<Icon Name="IconName.Edit" />
												@T.Pricing.SetValue
											</button>
											@if (item.OverrideValue is not null)
											{
												<button type="button" class="menu-item menu-item-danger" @onclick="() => ResetOverride(item)">
													<Icon Name="IconName.Undo" />
													@T.Pricing.ResetValue
												</button>
											}
										</ActionsDropdown>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
</div>

@* Установка значения на выбранном уровне *@
<ModalShell IsOpen="@_showEditDialog" Title="@EditTitle" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseEditDialog" OnSubmit="SubmitEdit">
	<ChildContent>
		@if (_editItem is { } editItem)
		{
			<div class="field">
				<label for="pricing-value">@T.Pricing.ValueLabel</label>
				<input id="pricing-value" type="number" step="0.0001" min="@editItem.Min" max="@editItem.Max" @bind="_editValue" />
				<span class="hint">@T.Pricing.ValueHint(editItem.Default is { } editDefault ? T.Pricing.Number(editDefault) : Texts.Dash, T.Pricing.Range(editItem.Min, editItem.Max))</span>
			</div>
			@if (_scope == ScopeCompany && editItem.CompanyRoles is [])
			{
				<p class="hint warning-text">
					<Icon Name="IconName.Warning" />
					@T.Pricing.CompanyNoEffectWarning
				</p>
			}
			<p class="hint">@T.Pricing.ResetHint</p>
			@if (!string.IsNullOrEmpty(_editError))
			{
				<p class="field-error" role="alert">@_editError</p>
			}
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseEditDialog">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="SubmitEdit">@T.Common.Save</button>
	</Footer>
</ModalShell>
