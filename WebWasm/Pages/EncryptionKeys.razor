@page "/encryption-keys"

<AppTitle Text="@T.Shell.EncryptionKeys" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.EncryptionKeys</h1>
			<p class="page-subtitle">@T.Keys.Subtitle</p>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Keys.BackfillTitle</h2>
			<button type="button" class="btn" @onclick="RunBackfill" disabled="@_backfillRunning">
				@if (_backfillRunning)
				{
					<span class="spinner" role="status"></span>
					@T.Keys.BackfillRunning
				}
				else
				{
					<Icon Name="IconName.Lock" />
					@T.Keys.RunBackfill
				}
			</button>
		</div>
		<p class="muted">@T.Keys.BackfillDescription</p>
		@if (_lastBackfillResult is not null)
		{
			<div class="table-wrap backfill-result">
				<table>
					<thead>
						<tr>
							<th class="num">@T.Shell.Users</th>
							<th class="num">@T.Keys.CompaniesInfo</th>
							<th class="num">@T.Keys.CompaniesRoot</th>
							<th class="num">@T.Shell.Vehicles</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="num">@_lastBackfillResult.UsersProcessed</td>
							<td class="num">@_lastBackfillResult.CompaniesProcessed</td>
							<td class="num">@_lastBackfillResult.CompanyRootProcessed</td>
							<td class="num">@_lastBackfillResult.VehiclesProcessed</td>
						</tr>
					</tbody>
				</table>
			</div>
		}
	</div>

	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Keys.KeysTitle</h2>
		</div>

		<div class="purposes">
			<div class="purpose">
				<div class="purpose-main">
					<span class="strong">@T.Enums.EncryptionPurpose(EncryptionPurpose.Data)</span>
					<span class="caption">@ActiveKeyLabel(EncryptionPurpose.Data)</span>
				</div>
				<div class="cluster">
					<button type="button" class="btn btn-sm" @onclick="() => CreateKey(EncryptionPurpose.Data)" disabled="@HasActiveKey(EncryptionPurpose.Data)">
						<Icon Name="IconName.Plus" />
						@T.Keys.CreateKey
					</button>
					<button type="button" class="btn btn-sm" @onclick="() => OpenRotateDialog(EncryptionPurpose.Data)" disabled="@(!HasActiveKey(EncryptionPurpose.Data))">
						<Icon Name="IconName.Rotate" />
						@T.Keys.RotateKey
					</button>
				</div>
			</div>

			<div class="purpose">
				<div class="purpose-main">
					<span class="strong">@T.Enums.EncryptionPurpose(EncryptionPurpose.BlindIndex)</span>
					<span class="caption">@ActiveKeyLabel(EncryptionPurpose.BlindIndex)</span>
					<span class="hint">@T.Keys.BlindIndexRotateHint</span>
				</div>
				<div class="cluster">
					<button type="button" class="btn btn-sm" @onclick="() => CreateKey(EncryptionPurpose.BlindIndex)" disabled="@HasActiveKey(EncryptionPurpose.BlindIndex)">
						<Icon Name="IconName.Plus" />
						@T.Keys.CreateKey
					</button>
					<button type="button" class="btn btn-sm" disabled>
						<Icon Name="IconName.Rotate" />
						@T.Keys.RotateKey
					</button>
				</div>
			</div>
		</div>

		@if (_keys.Count == 0)
		{
			<div class="empty">
				<Icon Name="IconName.Keys" />
				<p class="empty-title">@T.Keys.Empty</p>
				<p class="empty-hint">@T.Keys.EmptyHint</p>
			</div>
		}
		else
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>@T.Keys.Purpose</th>
							<th class="num">@T.Keys.Version</th>
							<th>@T.Common.Status</th>
							<th>@T.Common.Created</th>
							<th>@T.Keys.FullyMigrated</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var key in _keys)
						{
							<tr @key="key.Id">
								<td>@T.Enums.EncryptionPurpose(key.Purpose)</td>
								<td class="num">@key.Version</td>
								<td>
									<span class="@StatusTone.Of(key.IsActive).Badge()">@(key.IsActive ? T.Common.Active : T.Keys.Retired)</span>
								</td>
								<td class="tabular nowrap">@T.FormatDateTime(key.CreatedAt.ToLocalTime())</td>
								<td class="tabular nowrap">
									@if (key.FullyMigratedAt is { } migratedAt)
									{
										@T.FormatDateTime(migratedAt.ToLocalTime())
									}
									else if (key.IsActive)
									{
										<span class="muted">@Texts.Dash</span>
									}
									else
									{
										<span class="@Tone.Info.Badge()">@T.Keys.Migrating</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

<RotateKeyDialog IsOpen="@_showRotateDialog"
				 Purpose="@_rotateTargetPurpose"
				 OnClose="@CloseRotateDialog"
				 OnConfirm="@ConfirmRotate" />
