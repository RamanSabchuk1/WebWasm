@page "/orders"

<AppTitle Text="@T.Shell.Orders" />
<HeadContent>
	<meta name="description" content="@T.Orders.Subtitle" />
</HeadContent>

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.Orders</h1>
			<p class="page-subtitle">@T.Orders.Subtitle</p>
		</div>
	</div>

	<div class="stats">
		<div class="card stat">
			<span class="stat-label">@T.Orders.StatTotal</span>
			<span class="stat-value">@T.FormatNumber((decimal)_totalOrders, 0)</span>
		</div>
		<div class="card stat">
			<span class="stat-label">@T.Orders.StatPending</span>
			<span class="stat-value">@T.FormatNumber((decimal)_pendingOrders, 0)</span>
		</div>
		<div class="card stat">
			<span class="stat-label">@T.Orders.StatCompleted</span>
			<span class="stat-value">@T.FormatNumber((decimal)_completedOrders, 0)</span>
		</div>
	</div>

	<div class="card">
		<div class="toolbar">
			<label class="search">
				<Icon Name="IconName.Search" />
				<input type="search" placeholder="@T.Orders.SearchPlaceholder" aria-label="@T.Common.Search"
					   value="@_searchText" @oninput="OnSearchTextChanged" />
			</label>

			<button type="button" class="btn" aria-expanded="@Aria.State(_showFilters)" @onclick="() => _showFilters = !_showFilters">
				<Icon Name="IconName.Filter" />
				@T.Orders.Filters
				@if (ActiveFilterCount > 0)
				{
					<span class="badge badge-neutral tabular">@ActiveFilterCount</span>
				}
				<Icon Name="@(_showFilters ? IconName.ChevronUp : IconName.ChevronDown)" />
			</button>
		</div>

		@if (_showFilters)
		{
			<div class="form-grid filters">
				<div class="field">
					<span class="field-label">@T.Orders.Weight</span>
					<div class="cluster">
						<div class="range">
							<span class="caption">@T.Orders.WeightFrom</span>
							<input type="range"
								   value="@CurrentMinWeight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   @onchange="OnMinWeightChanged"
								   min="@_weightRangeMin.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   max="@_weightRangeMax.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   step="@_weightStep.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   disabled="@_weightFilterDisabled"
								   aria-label="@T.Orders.MinWeight" />
							<span class="range-value">@FormatWeight(CurrentMinWeight)</span>
						</div>
						<div class="range">
							<span class="caption">@T.Orders.WeightTo</span>
							<input type="range"
								   value="@CurrentMaxWeight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   @onchange="OnMaxWeightChanged"
								   min="@_weightRangeMin.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   max="@_weightRangeMax.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   step="@_weightStep.ToString(System.Globalization.CultureInfo.InvariantCulture)"
								   disabled="@_weightFilterDisabled"
								   aria-label="@T.Orders.MaxWeight" />
							<span class="range-value">@FormatWeight(CurrentMaxWeight)</span>
						</div>
						@if (_minWeight.HasValue || _maxWeight.HasValue)
						{
							<button type="button" class="btn btn-ghost btn-icon" @onclick="ClearWeightFilter"
									title="@T.Orders.ResetWeight" aria-label="@T.Orders.ResetWeight">
								<Icon Name="IconName.Close" Size="20" />
							</button>
						}
					</div>
				</div>

				<div class="field">
					<label for="orders-status-filter">@T.Orders.Statuses</label>
					<select id="orders-status-filter" @onchange="AddStatus" value="">
						<option value="" selected hidden>@T.Orders.SelectStatus</option>
						@foreach (var status in _allStatuses.Where(s => !_selectedStatuses.Contains(s)))
						{
							<option value="@status" @key="status">@T.Enums.OrderStatus(status)</option>
						}
					</select>

					@if (_selectedStatuses.Count > 0)
					{
						<div class="cluster">
							@foreach (var status in _selectedStatuses)
							{
								var name = T.Enums.OrderStatus(status);
								<button type="button" class="@StatusTone.Of(status).Badge() status-chip" @key="status"
										@onclick="() => RemoveStatus(status)" title="@T.Orders.RemoveStatus(name)" aria-label="@T.Orders.RemoveStatus(name)">
									@name
									<Icon Name="IconName.Close" />
								</button>
							}
						</div>
					}
				</div>

				<div class="field">
					<span class="field-label">@T.Orders.CreatedDate</span>
					<div class="cluster">
						<label class="date">
							<span class="caption">@T.Common.From</span>
							<input type="date" value="@(_fromDate?.ToString("yyyy-MM-dd") ?? "")" @onchange="OnFromDateChanged" />
						</label>
						<label class="date">
							<span class="caption">@T.Common.To</span>
							<input type="date" value="@(_toDate?.ToString("yyyy-MM-dd") ?? "")" @onchange="OnToDateChanged" />
						</label>
						@if (_fromDate.HasValue || _toDate.HasValue)
						{
							<button type="button" class="btn btn-ghost btn-icon" @onclick="ClearDateFilter"
									title="@T.Orders.ResetDates" aria-label="@T.Orders.ResetDates">
								<Icon Name="IconName.Close" Size="20" />
							</button>
						}
					</div>
				</div>
			</div>
		}

		@{ var filteredRows = FilteredOrders; }
		@if (filteredRows.Length > 0)
		{
			<div class="table-wrap">
				<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="o => o.Id">
					<TemplateColumn Title="@T.Common.Name">
						<HeaderTemplate>
							<SortHeader Title="@T.Common.Name" Key="name" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<a class="strong" href="@($"orders/{context.Id}")">@context.Name</a>
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="@T.Orders.Cost" Align="Align.End">
						<HeaderTemplate>
							<SortHeader Title="@T.Orders.Cost" Key="cost" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="nowrap">@T.FormatMoney(context.Cost)</span>
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="@T.Common.Status">
						<span class="@StatusTone.Of(context.Status).Badge()">@T.Enums.OrderStatus(context.Status)</span>
					</TemplateColumn>
					<TemplateColumn Title="@T.Common.Created">
						<HeaderTemplate>
							<SortHeader Title="@T.Common.Created" Key="created" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="tabular nowrap">@T.FormatDateTime(context.Created)</span>
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="@T.Common.Address">
						<span class="address">@context.Address</span>
					</TemplateColumn>
					<TemplateColumn Title="@T.Orders.Weight" Align="Align.End">
						<HeaderTemplate>
							<SortHeader Title="@T.Orders.Weight" Key="weight" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="nowrap">@FormatWeight(context.TotalWeight)</span>
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="@T.Orders.DeliveryTime">
						<HeaderTemplate>
							<SortHeader Title="@T.Orders.DeliveryTime" Key="delivered" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="tabular nowrap">@T.FormatDateTime(context.PreferredDeliveryTime)</span>
						</ChildContent>
					</TemplateColumn>
				</QuickGrid>
			</div>
			<CustomPaginator State="@_pagination" />
		}
		else if (_orders.Length == 0)
		{
			<div class="empty">
				<Icon Name="IconName.Orders" />
				<p class="empty-title">@T.Orders.Empty</p>
				<p class="empty-hint">@T.Orders.EmptyHint</p>
			</div>
		}
		else
		{
			<div class="empty">
				<Icon Name="IconName.Search" />
				<p class="empty-title">@T.Common.NothingFound</p>
				<p class="empty-hint">@T.Common.NothingFoundHint</p>
			</div>
		}
	</div>
</div>
