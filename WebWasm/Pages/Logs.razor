@page "/logs"

<AppTitle Text="@T.Shell.Logs" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.Logs</h1>
			<p class="page-subtitle">@T.Logs.Subtitle</p>
		</div>
	</div>

	<div class="card">
		@if (_logItems.Count > 0)
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>@T.Logs.Time</th>
							<th>@T.Logs.Level</th>
							<th>@T.Logs.Message</th>
							<th><span class="visually-hidden">@T.Common.Actions</span></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in _logItems)
						{
							var hasException = HasException(item.Log);
							<tr class="@(hasException ? "expandable" : null)" @onclick="() => ToggleExpand(item)" @key="item">
								<td class="tabular nowrap">@T.FormatDateTime(item.Log.TimeStamp.ToLocalTime())</td>
								<td><span class="@StatusTone.OfLogLevel(item.Log.Level).Badge()">@item.Log.Level</span></td>
								<td class="message">@item.Log.Message</td>
								<td class="row-actions" title="@item.Log.MessageTemplate" @onclick:stopPropagation>
									<div class="cluster">
										@if (hasException)
										{
											var label = item.IsExpanded ? T.Logs.HideException : T.Logs.ShowException;
											<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => ToggleExpand(item)"
													title="@label" aria-label="@label" aria-expanded="@Aria.State(item.IsExpanded)">
												<Icon Name="@(item.IsExpanded ? IconName.ChevronUp : IconName.ChevronDown)" />
											</button>
										}
										<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => CopyToClipboard(item.Log.MessageTemplate)"
												title="@T.Logs.CopyTemplate" aria-label="@T.Logs.CopyTemplate">
											<Icon Name="IconName.Copy" />
										</button>
									</div>
								</td>
							</tr>
							@if (item.IsExpanded && hasException)
							{
								<tr class="exception-row" @key="(item, true)">
									<td colspan="4">
										<pre class="exception">@item.Log.Exception</pre>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<div class="empty">
				<Icon Name="IconName.Logs" />
				<p class="empty-title">@T.Logs.Empty</p>
			</div>
		}
	</div>
</div>
