@page "/materials"

<AppTitle Text="@T.Shell.Materials" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.Materials</h1>
			<p class="page-subtitle">@T.Materials.Subtitle</p>
		</div>
		<button type="button" class="btn btn-primary" @onclick="OpenAddModal">
			<Icon Name="IconName.Plus" />
			@T.Materials.Add
		</button>
	</div>

	<MaterialsTable Materials="@_materials" OnEdit="@HandleEdit" OnDelete="@HandleDelete" />
</div>

<MaterialModal IsOpen="@_isModalOpen"
			   EditingMaterial="@_editingMaterial"
			   AllMaterials="@_materials"
			   OnClose="@CloseModal"
			   OnSubmit="@HandleSubmit" />
