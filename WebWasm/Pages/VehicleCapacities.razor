@page "/vehicle-capacities"

<AppTitle Text="@T.Shell.VehicleCapacities" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.VehicleCapacities</h1>
			<p class="page-subtitle">@T.Capacities.Subtitle</p>
		</div>
		<button type="button" class="btn btn-primary" @onclick="OpenCreateDialog">
			<Icon Name="IconName.Plus" />
			@T.Capacities.Add
		</button>
	</div>

	<div class="card">
		@if (_capacities.Count == 0)
		{
			<div class="empty">
				<Icon Name="IconName.Capacities" />
				<p class="empty-title">@T.Capacities.Empty</p>
				<p class="empty-hint">@T.Capacities.EmptyHint</p>
			</div>
		}
		else
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th class="num">@T.Capacities.Weight</th>
							<th class="num">@T.Capacities.MinPrice</th>
							<th class="num">@T.Capacities.MaxPrice</th>
							<th>@T.Common.Status</th>
							<th>@T.Common.Updated</th>
							<th><span class="visually-hidden">@T.Common.Actions</span></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var capacity in _capacities)
						{
							<tr @key="capacity.WeightKg">
								<td class="num strong nowrap">@FormatWeight(capacity.WeightKg)</td>
								<td class="num nowrap">@T.FormatMoney(capacity.DefaultMinPrice)</td>
								<td class="num nowrap">@T.FormatMoney(capacity.DefaultMaxPrice)</td>
								<td>
									<span class="@StatusTone.Of(capacity.IsActive).Badge()">@(capacity.IsActive ? T.Common.Active : T.Common.Inactive)</span>
								</td>
								<td class="tabular nowrap">@T.FormatDateTime(capacity.Updated.ToLocalTime())</td>
								<td class="num">
									<ActionsDropdown MenuHeight="90">
										<button type="button" class="menu-item" @onclick="() => OpenEditDialog(capacity)">
											<Icon Name="IconName.Edit" />
											@T.Common.Edit
										</button>
										<button type="button" class="menu-item menu-item-danger" @onclick="() => OpenDeleteDialog(capacity)">
											<Icon Name="IconName.Delete" />
											@T.Common.Delete
										</button>
									</ActionsDropdown>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

@* Добавление: вес + цены по умолчанию *@
<ModalShell IsOpen="@_showCreateDialog" Title="@T.Capacities.AddTitle" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseCreateDialog" OnSubmit="SubmitCreate">
	<ChildContent>
		<div class="field">
			<label for="capacity-weight">@T.Capacities.WeightKg</label>
			<input id="capacity-weight" type="number" min="1" step="500" @bind="_createWeightKg" />
		</div>
		<div class="form-grid">
			<div class="field">
				<label for="capacity-create-min">@T.Capacities.MinPrice</label>
				<input id="capacity-create-min" type="number" min="0" step="0.01" @bind="_createMinPrice" />
			</div>
			<div class="field">
				<label for="capacity-create-max">@T.Capacities.MaxPrice</label>
				<input id="capacity-create-max" type="number" min="0" step="0.01" @bind="_createMaxPrice" />
			</div>
		</div>
		<p class="hint">@T.Capacities.PricesHint</p>
		@if (!string.IsNullOrEmpty(_createError))
		{
			<p class="field-error" role="alert">@_createError</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseCreateDialog">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="SubmitCreate">@T.Common.Create</button>
	</Footer>
</ModalShell>

@* Редактирование: цены по умолчанию + активность *@
<ModalShell IsOpen="@_showEditDialog" Title="@T.Capacities.EditTitle(FormatWeight(_editWeightKg))" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseEditDialog" OnSubmit="SubmitEdit">
	<ChildContent>
		<div class="form-grid">
			<div class="field">
				<label for="capacity-edit-min">@T.Capacities.MinPrice</label>
				<input id="capacity-edit-min" type="number" min="0" step="0.01" @bind="_editMinPrice" />
			</div>
			<div class="field">
				<label for="capacity-edit-max">@T.Capacities.MaxPrice</label>
				<input id="capacity-edit-max" type="number" min="0" step="0.01" @bind="_editMaxPrice" />
			</div>
		</div>
		<p class="hint">@T.Capacities.PricesHint</p>
		<label class="checkbox">
			<input type="checkbox" @bind="_editIsActive" />
			@T.Common.Active
		</label>
		@if (!string.IsNullOrEmpty(_editError))
		{
			<p class="field-error" role="alert">@_editError</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseEditDialog">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="SubmitEdit">@T.Common.Save</button>
	</Footer>
</ModalShell>

@* Удаление (destructive, S4.5.3): перевести машины на другой тоннаж ИЛИ удалить машины (+ каскад слотов) *@
<ModalShell IsOpen="@_showDeleteDialog" Title="@T.Capacities.DeleteTitle(FormatWeight(_deleteWeightKg))" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseDeleteDialog" OnSubmit="SubmitDelete">
	<ChildContent>
		<p class="strong">@T.Capacities.VehiclesQuestion</p>
		<div class="stack">
			<label class="checkbox">
				<input type="radio" name="deleteMode" checked="@(_deleteModeReassign)" @onclick="() => _deleteModeReassign = true" />
				@T.Capacities.Reassign
			</label>
			@if (_deleteModeReassign)
			{
				@if (HasReassignTarget)
				{
					<div class="field">
						<label for="capacity-reassign">@T.Capacities.ReassignTarget</label>
						<select id="capacity-reassign" @bind="_reassignToWeightKg">
							@foreach (var target in _capacities.Where(x => x.WeightKg != _deleteWeightKg))
							{
								<option value="@target.WeightKg" @key="target.WeightKg">@FormatWeight(target.WeightKg)</option>
							}
						</select>
					</div>
				}
				else
				{
					<p class="field-error">@T.Capacities.NoTarget</p>
				}
			}
			<label class="checkbox">
				<input type="radio" name="deleteMode" checked="@(!_deleteModeReassign)" @onclick="() => _deleteModeReassign = false" />
				@T.Capacities.DeleteVehicles
			</label>
			@if (!_deleteModeReassign)
			{
				<p class="hint danger-text">
					<Icon Name="IconName.Warning" />
					@T.Capacities.DeleteVehiclesWarning
				</p>
			}
		</div>
		@if (!string.IsNullOrEmpty(_deleteError))
		{
			<p class="field-error" role="alert">@_deleteError</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseDeleteDialog">@T.Common.Cancel</button>
		<button type="button" class="btn btn-danger" @onclick="SubmitDelete" disabled="@(_deleteModeReassign && !HasReassignTarget)">@T.Common.Delete</button>
	</Footer>
</ModalShell>
