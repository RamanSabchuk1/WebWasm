@page "/payments"
@using Microsoft.AspNetCore.Components.QuickGrid
@using WebWasm.Components
@using WebWasm.Models

<PageTitle>Payments</PageTitle>

<div class="page-header">
	<h1>💳 Payments</h1>
	<p class="page-subtitle">Manage payment transactions</p>
</div>

<div class="content-card">
	<div class="card-header">
		<h3>Credit Cards</h3>
	</div>

	<div class="data-grid-container">
		<div class="data-grid-search">
			<input type="text"
				   placeholder="Search cards..."
				   @bind="_searchText"
				   @bind:after="SaveSearch"
				   @bind:event="oninput"
				   class="search-input" />
		</div>

		@if (_hasItems)
		{
			<div class="data-grid-scroll">
				<QuickGrid Items="@FilteredCards.AsQueryable()" Pagination="@_pagination" class="data-grid">
					<TemplateColumn Title="Card Number" Sortable="false">
						<HeaderTemplate>
							<button class="@SortHelper.GetHeaderClass(_sortState, "card")" @onclick='() => CycleSort("card")'>
								Card Number <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "card")</span>
							</button>
						</HeaderTemplate>
						<ChildContent>
							@context.MaskedCard
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="Expiration Date" Sortable="false">
						<HeaderTemplate>
							<button class="@SortHelper.GetHeaderClass(_sortState, "expiration")" @onclick='() => CycleSort("expiration")'>
								Expiration Date <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "expiration")</span>
							</button>
						</HeaderTemplate>
						<ChildContent>
							@context.ExpirationDate.ToString("MM/yyyy")
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="Unbind At" Sortable="false">
						<HeaderTemplate>
							<button class="@SortHelper.GetHeaderClass(_sortState, "unbind")" @onclick='() => CycleSort("unbind")'>
								Unbind At <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "unbind")</span>
							</button>
						</HeaderTemplate>
						<ChildContent>
							@context.UnbindAt.ToString("yyyy-MM-dd")
						</ChildContent>
					</TemplateColumn>
				</QuickGrid>
			</div>

			<div class="data-grid-pagination">
				<CustomPaginator State="@_pagination" />
			</div>
		}
		else
		{
			<div class="empty-state">
				<p>No credit cards registered yet</p>
			</div>
		}
	</div>
</div>
