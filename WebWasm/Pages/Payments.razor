@page "/payments"

<AppTitle Text="@T.Shell.Payments" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.Payments</h1>
			<p class="page-subtitle">@T.Payments.Subtitle</p>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Payments.Cards</h2>
		</div>

		<div class="toolbar">
			<label class="search">
				<Icon Name="IconName.Search" />
				<input type="search" placeholder="@T.Payments.SearchPlaceholder" aria-label="@T.Common.Search"
					   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
			</label>
		</div>

		@{ var filteredRows = FilteredCards; }
		@if (filteredRows.Count > 0)
		{
			<div class="table-wrap">
				<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="card => card.Id">
					<TemplateColumn Title="@T.Payments.CardNumber">
						<HeaderTemplate>
							<SortHeader Title="@T.Payments.CardNumber" Key="card" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="tabular nowrap">@context.MaskedCard</span>
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="@T.Payments.Expiration">
						<HeaderTemplate>
							<SortHeader Title="@T.Payments.Expiration" Key="expiration" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="tabular nowrap">@context.ExpirationDate.ToString("MM/yyyy")</span>
						</ChildContent>
					</TemplateColumn>
					<TemplateColumn Title="@T.Payments.UnbindAt">
						<HeaderTemplate>
							<SortHeader Title="@T.Payments.UnbindAt" Key="unbind" State="_sortState" OnSort="CycleSort" />
						</HeaderTemplate>
						<ChildContent>
							<span class="tabular nowrap">@T.FormatDate(context.UnbindAt)</span>
						</ChildContent>
					</TemplateColumn>
				</QuickGrid>
			</div>
			<CustomPaginator State="@_pagination" />
		}
		else
		{
			<div class="empty">
				<Icon Name="IconName.Payments" />
				<p class="empty-title">@(string.IsNullOrWhiteSpace(_searchText) ? T.Payments.Empty : T.Common.NothingFound)</p>
				@if (!string.IsNullOrWhiteSpace(_searchText))
				{
					<p class="empty-hint">@T.Common.NothingFoundHint</p>
				}
			</div>
		}
	</div>
</div>
