@page "/"

<AppTitle Text="@T.Shell.Home" />

<div class="page">
	<div class="page-header">
		<div>
			<h1>@T.Shell.Home</h1>
			<p class="page-subtitle">@T.Home.Subtitle</p>
		</div>
	</div>

	<div class="stats">
		<div class="card stat">
			<span class="stat-label"><Icon Name="IconName.Orders" />@T.Home.OrdersToday</span>
			<span class="stat-value">@FormatCount(_ordersTodayCount)</span>
		</div>
		<div class="card stat">
			<span class="stat-label"><Icon Name="IconName.Users" />@T.Shell.Users</span>
			<span class="stat-value">@FormatCount(_usersCount)</span>
		</div>
		<div class="card stat">
			<span class="stat-label"><Icon Name="IconName.Companies" />@T.Shell.Companies</span>
			<span class="stat-value">@FormatCount(_companiesCount)</span>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Home.Turnover</h2>
			<span class="badge badge-neutral tabular">@GetTurnoverPeriodLabel()</span>
		</div>

		<div class="toolbar">
			<div class="field">
				<span class="field-label">@T.Home.Period</span>
				<div class="segmented presets" role="group" aria-label="@T.Home.Period">
					@foreach (var preset in _turnoverPresets)
					{
						<button type="button" aria-pressed="@Aria.State(_turnoverPreset == preset)" @onclick="() => ApplyTurnoverPreset(preset)" @key="preset">
							@T.Home.Preset(preset)
						</button>
					}
				</div>
			</div>
			<div class="field period-date">
				<label for="turnover-from">@T.Home.PeriodStart</label>
				<input id="turnover-from" type="date"
					   value="@FormatDate(_turnoverFrom)"
					   max="@FormatDate(DateOnly.FromDateTime(DateTime.Today))"
					   @onchange="OnTurnoverFromChanged" />
			</div>
			<div class="field period-date">
				<label for="turnover-to">@T.Home.PeriodEnd</label>
				<input id="turnover-to" type="date"
					   value="@FormatDate(_turnoverTo)"
					   max="@FormatDate(DateOnly.FromDateTime(DateTime.Today))"
					   @onchange="OnTurnoverToChanged" />
			</div>
		</div>

		<div class="turnover">
			<div class="stat">
				<span class="stat-label"><Icon Name="IconName.Banknote" />@T.Home.Turnover</span>
				<span class="stat-value">@T.FormatMoney(_turnover.Turnover)</span>
				<span class="caption">@T.Home.TurnoverHint</span>
			</div>
			<div class="stat">
				<span class="stat-label"><Icon Name="IconName.Wallet" />@T.Home.Profit</span>
				<span class="stat-value">@T.FormatMoney(_turnover.Profit)</span>
				<span class="caption">@T.Home.ProfitHint</span>
			</div>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Home.RecentActivity</h2>
		</div>
		@if (_activityRecords.Length > 0)
		{
			<ul class="activity">
				@foreach (var (index, item) in _activityRecords.Index())
				{
					<li class="activity-item" @key="index">
						<Icon Name="IconName.Clock" Class="muted" />
						<div class="activity-text">
							<span>@item.Description</span>
							<span class="caption tabular">@T.FormatDateTime(item.Date.ToLocalTime())</span>
						</div>
					</li>
				}
			</ul>
		}
		else
		{
			<div class="empty">
				<Icon Name="IconName.Inbox" />
				<p class="empty-title">@T.Home.NoActivity</p>
			</div>
		}
	</div>
</div>
