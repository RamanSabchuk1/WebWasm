@page "/companies"
@using WebWasm.Components

<PageTitle>Companies</PageTitle>

<div class="page-header">
	<h1>🏢 Companies</h1>
	<p class="page-subtitle">Manage registered companies</p>
</div>

<div class="content-card">
	<div class="card-header">
		<h3>Company List</h3>
		<button class="btn-primary" @onclick="OpenAddCompanyModal">+ Add Company</button>
	</div>
	<CompaniesTable
					Companies="@_companies"
					OnToggleActive="@HandleToggleActive"
					OnEditCompany="@HandleEditCompany"
					OnDeleteCompany="@HandleDeleteCompany"
					OnEditSecurityLevel="company => _securityLevelTarget = company" />
</div>

<CompanyModal IsOpen="@_isCompanyModalOpen"
			  EditingCompany="@_editingCompany"
			  OnClose="@CloseCompanyModal"
			  OnSubmit="@HandleCompanySubmit" />

<SecurityLevelDialog IsOpen="_securityLevelTarget is not null"
					 EntityLabel="@($"Company: {_securityLevelTarget?.Name}")"
					 Endpoint="@($"admin/security-levels/companies/{_securityLevelTarget?.Id}")"
					 OnClose="() => _securityLevelTarget = null"
					 OnSaved="() => LoadCompanies(false)" />

<ConfirmDialog IsOpen="_confirm.IsOpen"
			   Title="@_confirm.Title"
			   Message="@_confirm.Message"
			   ConfirmText="Confirm"
			   CancelText="Cancel"
			   OnConfirm="_confirm.Confirm"
			   OnCancel="_confirm.Cancel" />