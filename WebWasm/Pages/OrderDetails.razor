@page "/orders/{Id:guid}"

<AppTitle Text="@TabTitle" />

<ConfirmDialog IsOpen="_confirm.IsOpen"
			   Title="@_confirm.Title"
			   Message="@_confirm.Message"
			   ConfirmText="@_confirmText"
			   IsDangerous="_confirmDangerous"
			   OnConfirm="_confirm.Confirm"
			   OnCancel="_confirm.Cancel" />

@* S5.2: SA-правка цены заказа (S4.2) — audit пишется на backend (pricingAudit) *@
<ModalShell IsOpen="@_showPriceEdit" TopLayer="true" Title="@T.Orders.PriceEditTitle" OnClose="@ClosePriceEdit" OnSubmit="SubmitPriceEdit">
	<ChildContent>
		<div class="form-grid">
			<div class="field">
				<label for="price-material">@T.Orders.MaterialCost</label>
				<input id="price-material" type="number" min="0" step="0.01" @bind="_editMaterialCost" @bind:after="RefreshPricePreview" />
			</div>
			<div class="field">
				<label for="price-commission">@T.Orders.CommissionBYN</label>
				<input id="price-commission" type="number" min="0" step="0.01" @bind="_editCommission" @bind:after="RefreshPricePreview" />
			</div>
			@* S5: суммарная стоимость доставок — бэкенд распределит её пропорционально по доставкам *@
			<div class="field span-all">
				<label for="price-deliveries">@T.Orders.DeliveriesTotalBYN</label>
				<input id="price-deliveries" type="number" min="0" step="0.01" @bind="_editDeliveryCost" @bind:after="RefreshPricePreview" disabled="@(_deliveryCount == 0)" />
				@if (_deliveryCount == 0)
				{
					<span class="hint">@T.Orders.NoDeliveriesHint</span>
				}
				else if (_deliveryCount > 1)
				{
					<span class="hint">@T.Orders.SplitHint(_deliveryCount)</span>
				}
			</div>
		</div>
		<p class="hint">@T.Orders.PriceEditNote</p>
		@if (_pricePreview is { } preview)
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th><span class="visually-hidden">@T.Orders.Component</span></th>
							<th class="num">@T.Orders.Amount</th>
							<th class="num">@T.Orders.Net</th>
							<th class="num">@T.Orders.Vat</th>
							<th class="num">@T.Orders.Fee</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>@T.Orders.Material</td>
							<td class="num nowrap">@T.FormatMoney(preview.MaterialCost)</td>
							<td class="num nowrap">@T.FormatMoney(preview.MaterialNetto)</td>
							<td class="num nowrap">@T.FormatMoney(preview.MaterialVatAmount)</td>
							<td class="num nowrap">@T.FormatMoney(preview.MaterialFeeAmount)</td>
						</tr>
						@foreach (var d in preview.DeliveryInfo)
						{
							<tr @key="d.DeliveryId">
								<td class="nowrap">@T.Orders.DeliveryOf(Tonnes(d.Weight))</td>
								<td class="num nowrap">@T.FormatMoney(d.TotalPrice)</td>
								<td class="num nowrap">@T.FormatMoney(d.Cost)</td>
								<td class="num nowrap">@T.FormatMoney(d.VatAmount)</td>
								<td class="num nowrap">@T.FormatMoney(d.FeeAmount)</td>
							</tr>
						}
						<tr>
							<td>@T.Orders.Commission</td>
							<td class="num nowrap">@T.FormatMoney(preview.Commission)</td>
							<td class="num muted">@Texts.Dash</td>
							<td class="num nowrap">@T.FormatMoney(preview.CommissionVatAmount)</td>
							<td class="num nowrap">@T.FormatMoney(preview.CommissionFeeAmount)</td>
						</tr>
						<tr class="total-row">
							<td>@T.Common.Total</td>
							<td class="num nowrap">@T.FormatMoney(preview.TotalCost)</td>
							<td></td>
							<td class="num nowrap">@T.FormatMoney(TotalVat(preview))</td>
							<td></td>
						</tr>
					</tbody>
				</table>
			</div>
		}
		@if (_hasAcceptedDelivery)
		{
			<p class="notice warning-text">
				<Icon Name="IconName.Warning" />
				<span>@T.Orders.AcceptedDeliveryWarning</span>
			</p>
		}
		@if (!string.IsNullOrEmpty(_priceEditError))
		{
			<p class="field-error" role="alert">@_priceEditError</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="ClosePriceEdit">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="SubmitPriceEdit">@T.Common.Save</button>
	</Footer>
</ModalShell>

@* S5.2: SA-правка PreferredDeliveryTime (S4.3) — 409 при отсутствии слота у водителя *@
<ModalShell IsOpen="@_showTimeEdit" ContainerClass="modal-sm" TopLayer="true" Title="@T.Orders.EditDeliveryTime" OnClose="@CloseTimeEdit" OnSubmit="SubmitTimeEdit">
	<ChildContent>
		<div class="field">
			<label for="delivery-time">@T.Orders.DeliveryTimeLocal</label>
			<input id="delivery-time" type="datetime-local" @bind="_editPreferredDeliveryTime" />
		</div>
		<p class="hint">@T.Orders.TimeEditNote</p>
		@if (!string.IsNullOrEmpty(_timeEditError))
		{
			<p class="field-error" role="alert">@_timeEditError</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseTimeEdit">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="SubmitTimeEdit">@T.Common.Save</button>
	</Footer>
</ModalShell>

@if (_order == null)
{
	<div class="empty">
		<span class="spinner spinner-lg"></span>
		<p class="empty-title">@T.Common.Loading</p>
	</div>
}
else
{
	var hint = StatusHint();
	<div class="page">
		<div class="page-header">
			<div>
				<h1>@T.Orders.OrderTitle(_order.Name)</h1>
				<p class="page-subtitle cluster">
					<span class="@StatusTone.Of(_order.Status).Badge()">@T.Enums.OrderStatus(_order.Status)</span>
					<span class="tabular">@_order.Id</span>
				</p>
			</div>
		</div>

		<section class="card no-print">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.Management</h2>
			</div>
			<p class="notice @(hint.Urgent ? "warning-text" : "muted")">
				<Icon Name="@(hint.Urgent ? IconName.Warning : IconName.Info)" />
				<span>@hint.Text</span>
			</p>
			<div class="form-grid">
				<div class="field">
					<label for="order-new-status">@T.Orders.NewStatus</label>
					<select id="order-new-status" @bind="_newStatus">
						@foreach (var status in _allStatuses)
						{
							<option value="@status" @key="status">@T.Enums.OrderStatus(status)</option>
						}
					</select>
				</div>
				<div class="field">
					<label for="order-state">@T.Orders.StateMessage</label>
					<input id="order-state" @bind="_newState" placeholder="@T.Orders.Optional" />
				</div>
			</div>
			<div class="cluster management-actions">
				<button type="button" class="btn btn-primary" @onclick="RequestUpdateStatus">
					<Icon Name="IconName.Check" />
					@T.Orders.UpdateStatus
				</button>
				<button type="button" class="btn" @onclick="RequestResetPayments">
					<Icon Name="IconName.Undo" />
					@T.Orders.ResetPayments
				</button>
			</div>
		</section>

		<section class="card">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.OrderInfo</h2>
			</div>
			<dl class="facts">
				<div><dt>@T.Orders.StateMessage</dt><dd>@OrDash(_order.State)</dd></div>
				<div><dt>@T.Common.Address</dt><dd>@_order.Address</dd></div>
				<div><dt>@T.Orders.Cost</dt><dd class="tabular">@T.FormatMoney(_order.Cost)</dd></div>
				<div><dt>@T.Common.Created</dt><dd class="tabular">@T.FormatDateTime(_order.Created)</dd></div>
				<div>
					<dt>@T.Orders.DeliveryTime</dt>
					<dd class="cluster">
						<span class="tabular">@T.FormatDateTime(_order.PreferredDeliveryTime)</span>
						<button type="button" class="btn btn-ghost btn-icon btn-sm no-print" @onclick="OpenTimeEdit"
								title="@T.Orders.EditDeliveryTime" aria-label="@T.Orders.EditDeliveryTime">
							<Icon Name="IconName.Edit" />
						</button>
					</dd>
				</div>
				<div><dt>@T.Orders.Duration</dt><dd class="tabular">@T.Orders.DurationValue(_order.Duration)</dd></div>
				<div><dt>@T.Orders.TotalWeight</dt><dd class="tabular">@FormatWeight(_order.TotalWeight)</dd></div>
				<div><dt>@T.Orders.Distance</dt><dd class="tabular">@T.Orders.Km(T.FormatNumber(_order.TotalKm, 1))</dd></div>
				<div><dt>@T.Orders.RegionLevel</dt><dd class="tabular">@_order.RegionLevelId</dd></div>
				<div><dt>@T.Orders.LoadingPlace</dt><dd>@(_order.LoadingPlace?.Name ?? Texts.Dash)</dd></div>
				<div>
					<dt>@T.Orders.Buyer</dt>
					<dd class="cluster">
						<span>@FullName(_order.UserInfo)</span>
						@if (_order.UserInfo != null)
						{
							<button type="button" class="btn btn-sm no-print" @onclick="ToggleUserDetails" aria-expanded="@Aria.State(_userDetailsOpen)">
								<Icon Name="@(_userDetailsOpen ? IconName.EyeOff : IconName.Eye)" />
								@(_userDetailsOpen ? T.Orders.HideDetails : T.Orders.ShowDetails)
							</button>
						}
					</dd>
				</div>
			</dl>
			@if (_order.UserInfo != null)
			{
				<div class="details-panel @(_userDetailsOpen ? null : "print-only")">
					<h3 class="section-title">@T.Orders.BuyerDetails</h3>
					@RenderUserDetails(_order.UserInfo)
				</div>
			}
		</section>

		<section class="card">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.Location</h2>
			</div>
			<div class="maps">
				@RenderLocation(_order.Location, T.Orders.DeliveryPoint)
				@{
					var level = _levels.FirstOrDefault(l => l.Id == _order.RegionLevelId);
				}
				@if (level is not null)
				{
					<div class="no-print">
						<TriangleMap Triangles="@level.Triangles"
									 LevelType="@level.Type"
									 ShowTitle="true"
									 MapHeight="240px" />
					</div>
				}
			</div>
		</section>

		<section class="card">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.Material</h2>
			</div>
			@if (_order.LoadingPlace?.MaterialType is { } type)
			{
				<div class="with-photo">
					@if (!string.IsNullOrEmpty(type.Photo))
					{
						<img class="photo material-photo" src="@type.Photo" alt="@type.Name" />
					}
					<dl class="facts">
						<div><dt>@T.Common.Name</dt><dd>@type.Name</dd></div>
						<div><dt>@T.Common.Description</dt><dd>@type.Description</dd></div>
						<div><dt>@T.Materials.Solidity</dt><dd class="tabular">@T.FormatNumber(type.Solidity)</dd></div>
					</dl>
				</div>
			}
			else
			{
				<p class="muted">@T.Orders.NoMaterial</p>
			}
		</section>

		<section class="card">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.Supplier</h2>
			</div>
			@if (_order.LoadingPlace is { Producer: { Company: { CompanyInfo: { } supplierInfo } supplier } producer } place)
			{
				<div class="with-photo">
					@if (!string.IsNullOrEmpty(supplierInfo.Photo))
					{
						<img class="photo" src="@supplierInfo.Photo" alt="@supplier.Name" />
					}
					<dl class="facts">
						<div><dt>@T.Common.Company</dt><dd>@supplier.Name</dd></div>
						<div><dt>@T.Orders.LegalForm</dt><dd>@supplierInfo.LegalType</dd></div>
						<div><dt>@T.Orders.Unp</dt><dd class="tabular">@supplierInfo.UNP</dd></div>
						<div><dt>@T.Orders.BankAccount</dt><dd class="tabular">@supplierInfo.BankAccount.BankNumber @supplierInfo.BankAccount.BIC</dd></div>
						<div><dt>@T.Common.Email</dt><dd>@OrDash(supplierInfo.CorporateEmail)</dd></div>
						<div><dt>@T.Common.Address</dt><dd>@supplierInfo.Address</dd></div>
						<div><dt>@T.Orders.Producer</dt><dd>@producer.Name</dd></div>
						<div><dt>@T.Orders.LoadingPlace</dt><dd>@place.Name</dd></div>
						<div><dt>@T.Orders.MaterialPrice</dt><dd class="tabular">@T.FormatMoney(place.Cost)</dd></div>
						<div><dt>@T.Orders.Volume</dt><dd class="tabular">@T.FormatNumber((decimal)place.Volume, 0)</dd></div>
					</dl>
				</div>
				<div class="maps">
					@RenderLocation(supplier.Location, T.Orders.SupplierCompany)
					@RenderLocation(place.Location, T.Orders.LoadingPlace)
				</div>
			}
			else
			{
				<p class="muted">@T.Orders.NoSupplier</p>
			}
		</section>

		@if (_calculationInfo is { } calc)
		{
			<section class="card">
				<div class="card-header">
					<h2 class="card-title">@T.Orders.Calculation</h2>
					<button type="button" class="btn btn-sm no-print" @onclick="OpenPriceEdit">
						<Icon Name="IconName.Edit" />
						@T.Orders.EditPrice
					</button>
				</div>
				@* D-po-21/25: инвариант по каждой составляющей: netto + НДС + fee = итог. «—» = заказ создан до разбивки. *@
				<dl class="facts">
					<div><dt>@T.Orders.TotalCost</dt><dd class="tabular strong">@T.FormatMoney(calc.TotalCost)</dd></div>
					<div><dt>@T.Orders.DeliveriesTotal</dt><dd class="tabular">@T.FormatMoney(calc.TotalCost - calc.MaterialCost - calc.Commission)</dd></div>
					<div><dt>@T.Orders.TotalVat</dt><dd class="tabular">@T.FormatMoney(TotalVat(calc))</dd></div>
				</dl>

				<h3 class="section-title subsection">@T.Orders.Material</h3>
				<dl class="facts">
					<div><dt>@T.Orders.Amount</dt><dd class="tabular">@T.FormatMoney(calc.MaterialCost)</dd></div>
					<div><dt>@T.Orders.Net</dt><dd class="tabular">@T.FormatMoney(calc.MaterialNetto)</dd></div>
					<div><dt>@T.Orders.Vat</dt><dd class="tabular">@T.FormatMoney(calc.MaterialVatAmount)</dd></div>
					<div><dt>@T.Orders.Fee</dt><dd class="tabular">@T.FormatMoney(calc.MaterialFeeAmount)</dd></div>
				</dl>

				<h3 class="section-title subsection">@T.Orders.Commission</h3>
				<dl class="facts">
					<div><dt>@T.Orders.Amount</dt><dd class="tabular">@T.FormatMoney(calc.Commission)</dd></div>
					<div><dt>@T.Orders.Vat</dt><dd class="tabular">@T.FormatMoney(calc.CommissionVatAmount)</dd></div>
					<div><dt>@T.Orders.Fee</dt><dd class="tabular">@T.FormatMoney(calc.CommissionFeeAmount)</dd></div>
				</dl>

				<h3 class="section-title subsection">@T.Orders.Deliveries</h3>
				@if (calc.DeliveryInfo.Length > 0)
				{
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th>@T.Orders.Weight</th>
									<th class="num">@T.Orders.Amount</th>
									<th class="num">@T.Orders.Net</th>
									<th class="num">@T.Orders.VatRate</th>
									<th class="num">@T.Orders.Vat</th>
									<th class="num">@T.Orders.Fee</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var d in calc.DeliveryInfo)
								{
									<tr @key="d.DeliveryId">
										<td class="tabular nowrap">@Tonnes(d.Weight)</td>
										<td class="num nowrap">@T.FormatMoney(d.TotalPrice)</td>
										<td class="num nowrap">@T.FormatMoney(d.Cost)</td>
										<td class="num nowrap">@Percent(d.Vat * 100)</td>
										<td class="num nowrap">@T.FormatMoney(d.VatAmount)</td>
										<td class="num nowrap">@T.FormatMoney(d.FeeAmount)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				else
				{
					<p class="muted">@T.Orders.NoDeliveries</p>
				}
			</section>
		}

		<section class="card">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.Deliveries</h2>
			</div>
			@if (_order.Deliveries != null && _order.Deliveries.Any())
			{
				<div class="groups">
					@foreach (var deliveryGroup in _order.Deliveries.GroupBy(d => d.NetoWeight))
					{
						<div class="stack" @key="deliveryGroup.Key">
							<h3 class="section-title">@T.Orders.WeightGroup(FormatWeight(deliveryGroup.Key))</h3>
							<div class="table-wrap">
								<table>
									<thead>
										<tr>
											<th>@T.Orders.DeliveryState</th>
											<th>@T.Orders.BatchNumber</th>
											<th class="num">@T.Orders.Cost</th>
											<th class="num">@T.Orders.Weights</th>
											<th>@T.Orders.Driver</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var d in deliveryGroup)
										{
											<tr @key="d.Id">
												<td>@d.State</td>
												<td class="tabular">@OrDash(d.BatchNumber)</td>
												<td class="num nowrap">@T.FormatMoney(d.DeliveryCost)</td>
												<td class="num nowrap">@FormatWeight(d.NetoWeight) / @FormatWeight(d.GrossWeight) / @FormatWeight(d.AppliedWeight)</td>
												<td>
													@if (d.Driver is { } assigned)
													{
														<div class="driver">
															<div class="driver-info">
																<span class="strong">@assigned.UserInfo?.FirstName @assigned.UserInfo?.LastName</span>
																@if (assigned.Vehicles?.FirstOrDefault() is { } vehicle)
																{
																	<span class="caption vehicle">
																		<Icon Name="IconName.Vehicles" />
																		@vehicle.Model
																		<span class="tabular">(@vehicle.RegistrationNumber)</span>
																	</span>
																}
															</div>
															<button type="button" class="btn btn-sm no-print" @onclick="() => SetDriverToView(assigned.Id)">
																<Icon Name="IconName.User" />
																@T.Common.Details
															</button>
														</div>
													}
													else
													{
														<span class="muted">@Texts.Dash</span>
													}
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>

							@if (deliveryGroup.Any(d => d.Driver == null))
							{
								<div class="assign no-print">
									<div class="field">
										<label for="@($"assign-driver-{deliveryGroup.Key}")">@T.Orders.AssignDriverFor(FormatWeight(deliveryGroup.Key))</label>
										<select id="@($"assign-driver-{deliveryGroup.Key}")"
												@bind:get="_selectedDriverIds.GetValueOrDefault(deliveryGroup.Key)"
												@bind:set="(val) => _selectedDriverIds[deliveryGroup.Key] = val">
											<option value="@Guid.Empty">@T.Orders.SelectDriverOption</option>
											@foreach (var (company, driver, hasSlot) in GetDrivers(_order.Duration.TotalMinutes, deliveryGroup.Key, _order.PreferredDeliveryTime))
											{
												<option value="@driver.Id" disabled="@(!hasSlot)" @key="driver.Id">
													@company.Name @(driver.UserInfo?.MobilePhone) @(string.IsNullOrWhiteSpace(driver.UserInfo?.FirstName) ? T.Orders.NoName : driver.UserInfo?.FirstName)@(hasSlot ? null : " · " + T.Orders.NoSlot)
												</option>
											}
										</select>
									</div>
									<button type="button" class="btn" @onclick="() => RequestAcceptDelivery(deliveryGroup.Key)">
										<Icon Name="IconName.UserCheck" />
										@T.Orders.Assign
									</button>
								</div>
							}
						</div>
					}
				</div>

				@* Printout: every driver's details below the tables, as if «Details» were opened for each of them. *@
				<div class="print-only">
					@foreach (var driver in _order.Deliveries.Select(d => d.Driver).OfType<Driver>().DistinctBy(d => d.Id))
					{
						<div class="details-panel" @key="driver.Id">
							<h3 class="section-title">@T.Orders.DriverDetailsOf(FullName(driver.UserInfo))</h3>
							@RenderUserDetails(driver.UserInfo, GetDriverCompany(driver.Id))
						</div>
					}
				</div>

				@* Not printed: the printout has every driver's details in the block above. *@
				@if (_driverInfo?.UserInfo != null)
				{
					<div class="details-panel no-print">
						<div class="panel-header">
							<h3 class="section-title">@T.Orders.DriverDetails</h3>
							<button type="button" class="btn btn-ghost btn-icon" @onclick="_ => SetDriverToView(null)"
									title="@T.Common.Close" aria-label="@T.Common.Close">
								<Icon Name="IconName.Close" Size="20" />
							</button>
						</div>
						@RenderUserDetails(_driverInfo.UserInfo)
					</div>
				}
			}
			else
			{
				<p class="muted">@T.Orders.NoDeliveries</p>
			}
		</section>

		<section class="card">
			<div class="card-header">
				<h2 class="card-title">@T.Orders.Transactions</h2>
			</div>
			@if (_order.Transactions != null && _order.Transactions.Any())
			{
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th>@T.Common.Date</th>
								<th class="num">@T.Orders.Amount</th>
								<th>@T.Common.Status</th>
								<th>@T.Orders.PaymentMethod</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var transaction in _order.Transactions)
							{
								<tr @key="transaction.Id">
									<td class="tabular nowrap">@T.FormatDateTime(transaction.Date)</td>
									<td class="num nowrap">@T.FormatMoney(transaction.Amount)</td>
									<td><span class="@StatusTone.Of(transaction.Status).Badge()">@T.Enums.PaymentTransaction(transaction.Status)</span></td>
									<td>@T.Enums.PaymentMethod(transaction.PaymentMethod)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<p class="muted">@T.Orders.NoTransactions</p>
			}
		</section>
	</div>
}

@code {
	// Паспорт/компания пользователя: заказчик, выбранный водитель и печатные детали водителей по доставкам.
	// company передаётся отдельно: у водителей связь с компанией живёт в _driversWithCompany, а не в UserInfo.
	private RenderFragment RenderUserDetails(UserInfo? userInfo, Company? company = null) => __builder =>
	{
		@if (userInfo != null)
		{
			var c = company ?? userInfo.Company;
			<dl class="kv user-details">
				@if (userInfo.Passport != null)
				{
					foreach (var (key, value) in userInfo.Passport)
					{
						<dt @key="key">@PrintKey(key)</dt>
						<dd>@value</dd>
					}
				}
				@if (c?.CompanyInfo != null)
				{
					<dt>@T.Common.Company</dt>
					<dd>@c.Name</dd>
					<dt>@T.Orders.CompanyAddress</dt>
					<dd>@c.CompanyInfo.Address</dd>
					<dt>@T.Orders.Unp</dt>
					<dd class="tabular">@c.CompanyInfo.UNP</dd>
					<dt>@T.Orders.LegalForm</dt>
					<dd>@c.CompanyInfo.LegalType</dd>
					<dt>@T.Orders.BankAccount</dt>
					<dd class="tabular">@c.CompanyInfo.BankAccount.BankNumber @c.CompanyInfo.BankAccount.BIC</dd>
				}
			</dl>
		}
	};

	private RenderFragment RenderLocation(Location location, string title) => __builder =>
	{
		<div class="location">
			<div class="print-location">
				<span class="caption">@title</span>
				<span class="tabular">@T.Orders.Coordinates(T.FormatNumber(location.Latitude, 6), T.FormatNumber(location.Longitude, 6))</span>
			</div>
			<div class="no-print">
				<LocationMapPicker InitialLocation="@location"
								   MapHeight="240px"
								   ShowInputs="false"
								   Title="@title"
								   OnLocationChanged="_ => {}" />
			</div>
		</div>
	};
}
