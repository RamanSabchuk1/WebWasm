<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- C# & Code Analysis -->
		<LangVersion>preview</LangVersion>
		<AnalysisLevel>latest</AnalysisLevel>
		<!-- IL2111: Router.NotFoundPage in generated App_razor.g.cs, framework annotation, not our code -->
		<NoWarn>$(NoWarn);IL2111</NoWarn>

		<!-- PWA & Static assets -->
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>

		<!-- Size optimization (Trimming and Globalization) -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- Turn off not used features -->
		<EventSourceSupport>false</EventSourceSupport>
		<BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
		<MetricsSupport>false</MetricsSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BlazorWasmBrotliLoader.Build" Version="1.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-rc.1.26425.128" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.1.26425.128" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
