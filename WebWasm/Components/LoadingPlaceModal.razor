<ModalShell IsOpen="IsOpen" Title="@(IsEditMode ? T.Providers.PlaceEditTitle : T.Providers.PlaceAddTitle)" OnClose="CloseModal" OnSubmit="HandleSubmit">
	<ChildContent>
		<div class="field">
			<label for="loading-place-name">@T.Common.Name</label>
			<input id="loading-place-name" type="text" @bind="_name" />
		</div>

		<div class="field">
			<label for="loading-place-material">@T.Providers.Material</label>
			<select id="loading-place-material" @bind="_materialTypeId">
				<option value="@Guid.Empty">@T.Providers.SelectMaterial</option>
				@foreach (var material in MaterialTypes)
				{
					<option value="@material.Id" @key="material.Id">@material.Name (@T.FormatNumber(material.Solidity))</option>
				}
			</select>
		</div>

		<div class="form-grid">
			<div class="field">
				<label for="loading-place-cost">@T.Providers.CostLabel</label>
				<input id="loading-place-cost" type="number" step="0.01" min="0" @bind="_cost" />
			</div>

			<div class="field">
				<label for="loading-place-volume">@T.Providers.VolumeLabel</label>
				<input id="loading-place-volume" type="number" min="1" @bind="_volume" />
			</div>
		</div>

		<section>
			<h3 class="section-title">@T.Providers.Location</h3>
			<LocationMapPicker InitialLocation="@_location" OnLocationChanged="HandleLocationChanged" />
		</section>

		@if (_showErrors && !IsValid)
		{
			<p class="field-error" role="alert">@T.Providers.PlaceFillRequired</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!IsValid)">
			@(IsEditMode ? T.Common.Save : T.Common.Create)
		</button>
	</Footer>
</ModalShell>
