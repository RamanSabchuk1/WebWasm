@using WebWasm.Models
@inherits LeafletMapBase

<div class="location-picker-container">
	@if (!string.IsNullOrEmpty(Title))
	{
		<p class="map-hint">📍 @Title</p>
	}
	<div class="map-wrapper" @attributes="@(string.IsNullOrEmpty(MapHeight) ? null : new Dictionary<string, object> { { "style", $"height:{MapHeight}" } })">
		<div @ref="MapElement" class="leaflet-map"></div>
	</div>

	@if (ShowInputs)
	{
		<div class="location-info">
			<div class="coordinates">
				<div class="coord-group">
					<label>Latitude:</label>
					<input type="number"
						   step="0.000001"
						   @bind="_latitude"
						   @bind:event="oninput"
						   @onchange="UpdateMarkerFromInput"
						   class="coord-input" />
				</div>
				<div class="coord-group">
					<label>Longitude:</label>
					<input type="number"
						   step="0.000001"
						   @bind="_longitude"
						   @bind:event="oninput"
						   @onchange="UpdateMarkerFromInput"
						   class="coord-input" />
				</div>
			</div>
			<p class="map-hint">💡 Click on the map to select a location</p>
		</div>
	}

</div>
