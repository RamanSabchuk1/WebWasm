@if (Region is { } region)
{
	<ModalShell IsOpen="IsOpen" ContainerClass="modal-lg" Title="@T.Regions.DetailsTitle(region.Name)" OnClose="CloseModal">
		<ChildContent>
			@if (region.Levels?.Count > 0)
			{
				@foreach (var level in region.Levels)
				{
					<section class="card" @key="level.Id">
						<div class="card-header">
							<h3 class="card-title">@T.Enums.LevelType(level.Type)</h3>
							<div class="cluster">
								<button type="button" class="btn btn-ghost btn-sm" @onclick="() => OnEditLevel.InvokeAsync((region, level))">
									<Icon Name="IconName.Edit" />
									@T.Common.Edit
								</button>
								<button type="button" class="btn btn-ghost btn-sm danger-text" @onclick="() => OnDeleteLevel.InvokeAsync((region, level.Id))">
									<Icon Name="IconName.Delete" />
									@T.Common.Delete
								</button>
							</div>
						</div>

						<div class="stack">
							<dl class="kv">
								<dt>@T.Regions.Algorithm</dt>
								<dd>@T.Regions.AlgorithmName(level.CalculationAlgorithm)</dd>
								<dt>@T.Regions.Triangles</dt>
								<dd class="tabular">@(level.Triangles?.Count ?? 0)</dd>
							</dl>

							@if (level.Info?.Info?.Count > 0)
							{
								<div class="table-wrap">
									<table>
										<thead>
											<tr>
												<th class="col-justify-end">@T.Regions.NetWeight</th>
												<th class="col-justify-end">@T.Regions.MinPrice</th>
												<th class="col-justify-end">@T.Regions.MaxPrice</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var (weight, price) in level.Info.Info)
											{
												<tr @key="weight">
													<td class="num">@T.FormatNumber((decimal)weight, 0)</td>
													<td class="num">@T.FormatNumber(price.MinPrice)</td>
													<td class="num">@T.FormatNumber(price.MaxPrice)</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}

							@if (level.Triangles?.Count > 0)
							{
								<TriangleMap Triangles="@level.Triangles" LevelType="@level.Type" MapHeight="400px" />
							}
							else
							{
								<p class="muted small">@T.Regions.NoBoundary</p>
							}
						</div>
					</section>
				}
			}
			else
			{
				<div class="empty">
					<Icon Name="IconName.Regions" />
					<p class="empty-title">@T.Regions.NoLevels</p>
					<p class="empty-hint">@T.Regions.NoLevelsHint</p>
				</div>
			}
		</ChildContent>
		<Footer>
			<button type="button" class="btn" @onclick="CloseModal">@T.Common.Close</button>
			<button type="button" class="btn btn-primary" @onclick="() => OnAddLevel.InvokeAsync(region)">
				<Icon Name="IconName.Plus" />
				@T.Regions.AddLevel
			</button>
		</Footer>
	</ModalShell>
}
