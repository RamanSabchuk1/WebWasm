<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Support.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
	</div>

	@{ var filteredRows = FilteredSuggestions; }
	@if (filteredRows.Length > 0)
	{
		<div class="table-wrap">
			<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="row => row.Suggestion.Id">
				<TemplateColumn Title="@T.Common.Name">
					<HeaderTemplate>
						<SortHeader Title="@T.Common.Name" Key="name" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						<span class="strong">@context.Suggestion.Name</span>
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Support.User">
					<HeaderTemplate>
						<SortHeader Title="@T.Support.User" Key="user" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						@(context.GetUserName() ?? T.Support.Anonymous)
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Support.Data">
					@if (context.Suggestion.Data.Count > 0)
					{
						var expanded = IsExpanded(context.Suggestion.Id);
						<button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleExpand(context.Suggestion.Id)" aria-expanded="@Aria.State(expanded)">
							<Icon Name="@(expanded ? IconName.ChevronDown : IconName.ChevronRight)" />
							@T.Support.Items(context.Suggestion.Data.Count)
						</button>
						@if (expanded)
						{
							<dl class="kv data-list">
								@foreach (var kvp in context.Suggestion.Data)
								{
									<dt @key="kvp.Key">@kvp.Key</dt>
									<dd>@kvp.Value</dd>
								}
							</dl>
						}
					}
					else
					{
						<span class="muted">@T.Support.NoData</span>
					}
				</TemplateColumn>
				<TemplateColumn Title="@T.Common.Created">
					<HeaderTemplate>
						<SortHeader Title="@T.Common.Created" Key="created" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						<span class="tabular nowrap">@T.FormatDateTime(context.Suggestion.Created)</span>
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Common.Status">
					@if (context.Suggestion.Applied is { } applied)
					{
						<span class="@Tone.Success.Badge()" title="@T.FormatDateTime(applied)">@T.Support.Applied</span>
					}
					else
					{
						<span class="@Tone.Warning.Badge()">@T.Support.Pending</span>
					}
				</TemplateColumn>
				<TemplateColumn Title="@T.Common.Actions" Align="Align.End">
					<ActionsDropdown MenuHeight="50">
						<button type="button" class="menu-item" disabled="@context.Suggestion.Applied.HasValue"
								@onclick="() => OnApply.InvokeAsync(context.Suggestion.Id)">
							<Icon Name="IconName.Check" />
							@T.Support.Apply
						</button>
					</ActionsDropdown>
				</TemplateColumn>
			</QuickGrid>
		</div>
		<CustomPaginator State="@_pagination" />
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Inbox" />
			<p class="empty-title">@(string.IsNullOrWhiteSpace(_searchText) ? T.Support.Empty : T.Common.NothingFound)</p>
		</div>
	}
</div>
