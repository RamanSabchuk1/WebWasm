@using Microsoft.AspNetCore.Components.QuickGrid
@using WebWasm.Models
@using WebWasm.Services

<div class="data-grid-container">
	<div class="data-grid-search">
		<input type="text" 
			   placeholder="Search..." 
			   @bind="_searchText" 
			   @bind:after="SaveSearch"
			   @bind:event="oninput"
			   class="search-input" />
	</div>

	@if (_hasItems)
	{
		<div class="data-grid-scroll">
			<QuickGrid Items="@FilteredSuggestions" Pagination="@_pagination" class="data-grid">
				<TemplateColumn Title="Name" Sortable="false">
					<HeaderTemplate>
						<button class="@SortHelper.GetHeaderClass(_sortState, "name")" @onclick='() => CycleSort("name")'>
							Name <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "name")</span>
						</button>
					</HeaderTemplate>
					<ChildContent>
						@context.Suggestion.Name
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="User" Sortable="false">
					<HeaderTemplate>
						<button class="@SortHelper.GetHeaderClass(_sortState, "user")" @onclick='() => CycleSort("user")'>
							User <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "user")</span>
						</button>
					</HeaderTemplate>
					<ChildContent>
						@context.GetUserName()
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="Data" Sortable="false">
					<div class="data-cell">
						@if (context.Suggestion.Data.Count > 0)
						{
							<button class="btn-expand" @onclick="() => ToggleExpand(context.Suggestion.Id)">
								@(IsExpanded(context.Suggestion.Id) ? "▼" : "▶") @context.Suggestion.Data.Count item(s)
							</button>
							@if (IsExpanded(context.Suggestion.Id))
							{
								<div class="data-expanded">
									@foreach (var kvp in context.Suggestion.Data)
									{
										<div class="data-item">
											<span class="data-key">@kvp.Key:</span>
											<span class="data-value">@kvp.Value</span>
										</div>
									}
								</div>
							}
						}
						else
						{
							<span class="text-muted">No data</span>
						}
					</div>
				</TemplateColumn>
				<TemplateColumn Title="Created" Sortable="false">
					<HeaderTemplate>
						<button class="@SortHelper.GetHeaderClass(_sortState, "created")" @onclick='() => CycleSort("created")'>
							Created <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "created")</span>
						</button>
					</HeaderTemplate>
					<ChildContent>
						@context.Suggestion.Created.ToString("yyyy-MM-dd HH:mm")
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="Applied" Sortable="false">
					@if (context.Suggestion.Applied.HasValue)
					{
						<span class="status-badge status-applied">@context.Suggestion.Applied.Value.ToString("yyyy-MM-dd HH:mm")</span>
					}
					else
					{
						<span class="status-badge status-pending">Pending</span>
					}
				</TemplateColumn>
				<TemplateColumn Title="Actions" Sortable="false">
					<button class="btn-action" 
							disabled="@context.Suggestion.Applied.HasValue"
							@onclick="() => OnApply.InvokeAsync(context.Suggestion.Id)">
						@(context.Suggestion.Applied.HasValue ? "Applied" : "Apply")
					</button>
				</TemplateColumn>
			</QuickGrid>
		</div>

		<div class="data-grid-pagination">
			<CustomPaginator State="@_pagination" />
		</div>
	}
	else
	{
		<div class="empty-state">
			<p>No suggestions available</p>
		</div>
	}
</div>
