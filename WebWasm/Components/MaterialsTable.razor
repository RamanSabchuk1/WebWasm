<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Materials.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
	</div>

	@if (_hasItems)
	{
		var roots = FilteredMaterials;
		<ul class="tree">
			@foreach (var material in PageOf(roots))
			{
				@RenderMaterialRow(material, 0)
			}
		</ul>
		<CustomPaginator State="@_pagination" TotalItems="@roots.Count" AfterNavigate="StateHasChanged" />
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Materials" />
			<p class="empty-title">@T.Materials.Empty</p>
			<p class="empty-hint">@T.Materials.EmptyHint</p>
		</div>
	}
</div>

<ConfirmDialog IsOpen="@_confirm.IsOpen" Title="@_confirm.Title" Message="@_confirm.Message"
			   OnConfirm="_confirm.Confirm" OnCancel="_confirm.Cancel" />

@code {
	private RenderFragment RenderMaterialRow(MaterialType material, int level) => __builder =>
	{
		var children = _childrenByParent[material.Id].ToList();
		var expanded = _expandedIds.Contains(material.Id);

		<li class="tree-row" @key="material.Id" style="--level: @level">
			@if (children.Count > 0)
			{
				<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => ToggleExpand(material.Id)"
						title="@(expanded ? T.Common.Collapse : T.Common.Expand)" aria-label="@(expanded ? T.Common.Collapse : T.Common.Expand)" aria-expanded="@Aria.State(expanded)">
					<Icon Name="@(expanded ? IconName.ChevronDown : IconName.ChevronRight)" />
				</button>
			}
			else
			{
				<span class="tree-spacer"></span>
			}

			<div class="thumb">
				@if (!string.IsNullOrEmpty(material.Photo))
				{
					<img src="@material.Photo" alt="" loading="lazy" />
				}
				else
				{
					<Icon Name="IconName.Image" />
				}
			</div>

			<div class="tree-main">
				<span class="strong">@material.Name</span>
				<span class="caption">@material.Description</span>
			</div>

			<span class="badge badge-neutral tabular">@T.Materials.Solidity @T.FormatNumber(material.Solidity)</span>

			<ActionsDropdown MenuHeight="90">
				<button type="button" class="menu-item" @onclick="() => OnEdit.InvokeAsync(material)">
					<Icon Name="IconName.Edit" />
					@T.Common.Edit
				</button>
				<button type="button" class="menu-item menu-item-danger" @onclick="() => AskDelete(material, children.Count > 0)">
					<Icon Name="IconName.Delete" />
					@T.Common.Delete
				</button>
			</ActionsDropdown>
		</li>

		@if (expanded)
		{
			foreach (var child in children)
			{
				@RenderMaterialRow(child, level + 1)
			}
		}
	};
}
