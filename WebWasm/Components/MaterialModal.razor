<ModalShell IsOpen="IsOpen" Title="@(IsEditMode ? T.Materials.EditTitle : T.Materials.AddTitle)" OnClose="CloseModal" OnSubmit="HandleSubmit">
	<ChildContent>
		<div class="field">
			<label for="material-name">@T.Common.Name</label>
			<input id="material-name" type="text" @bind="_name" placeholder="@T.Materials.NamePlaceholder" />
		</div>

		<div class="field">
			<label for="material-description">@T.Common.Description</label>
			<textarea id="material-description" rows="3" @bind="_description"></textarea>
		</div>

		<div class="form-grid">
			<div class="field">
				<label for="material-solidity">@T.Materials.Solidity</label>
				<input id="material-solidity" type="number" step="0.01" min="0" @bind="_solidity" />
			</div>

			<div class="field">
				<label for="material-parent">@T.Materials.Parent</label>
				@if (CanSetParent)
				{
					<select id="material-parent" @bind="_parentId">
						<option value="">@T.Materials.NoParent</option>
						@foreach (var material in AvailableMaterials)
						{
							<option value="@material.Id" @key="material.Id">@material.Name</option>
						}
					</select>
					<span class="hint">@T.Materials.ParentHint</span>
				}
				else
				{
					<span class="hint">@T.Materials.RootCannotMove</span>
				}
			</div>
		</div>

		<div class="field">
			<label for="material-photo">@T.Materials.PhotoUrl</label>
			<input id="material-photo" type="url" @bind="_photo" placeholder="@T.Materials.PhotoUrlPlaceholder" />
			@if (!string.IsNullOrEmpty(_photo))
			{
				<img class="photo-preview" src="@_photo" alt="" />
			}
		</div>

		@if (_showErrors && !IsValid)
		{
			<p class="field-error" role="alert">@T.Materials.FillRequired</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!IsValid)">
			@(IsEditMode ? T.Common.Save : T.Common.Create)
		</button>
	</Footer>
</ModalShell>
