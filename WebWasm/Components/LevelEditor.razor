@* S5: Enter = create the level. In edit mode the footer has no success button (only Close and the local
   «Save prices» / «Save boundary»), so Enter does nothing there. *@
<ModalShell IsOpen="IsOpen" ContainerClass="modal-fullscreen" Title="@(IsEditMode ? T.Regions.EditLevelTitle : T.Regions.AddLevelTitle)"
			OnClose="CloseEditor" OnSubmit="@(IsEditMode ? EventCallback.Empty : EventCallback.Factory.Create(this, HandleSubmit))">
	<ChildContent>
		<div class="editor-grid">
			<div class="config-panel stack">
				<div class="field">
					<span class="field-label">@T.Regions.LevelType</span>
					<div class="segmented" role="group" aria-label="@T.Regions.LevelType">
						@foreach (var type in Enum.GetValues<LevelType>())
						{
							<button type="button" aria-pressed="@Aria.State(_levelType == type)" @onclick="() => _levelType = type" @key="type">
								@T.Enums.LevelType(type)
							</button>
						}
					</div>
				</div>

				<div class="field">
					<span class="field-label">@T.Regions.Algorithm</span>
					<div class="segmented" role="group" aria-label="@T.Regions.Algorithm">
						@foreach (var algorithm in Algorithms)
						{
							<button type="button" aria-pressed="@Aria.State(_algorithm == algorithm)" @onclick="() => _algorithm = algorithm" @key="algorithm">
								@T.Regions.AlgorithmName(algorithm)
							</button>
						}
					</div>
				</div>

				<h3 class="section-title">@T.Regions.Prices</h3>
				<PriceInfoEditor @key="@GetPriceEditorKey()" @ref="_priceEditor" ExistingPrices="@_priceInfo" />

				@if (IsEditMode)
				{
					<div>
						<button type="button" class="btn" @onclick="HandleSubmitPrices" disabled="@(_priceEditor?.IsValid != true)">
							<Icon Name="IconName.Save" />
							@T.Regions.SavePrices
						</button>
					</div>
				}
			</div>

			<div class="map-panel">
				@if (_showDrawer)
				{
					<PolygonDrawer InitialPoints="@_points"
								   OnCancel="@CancelDrawer"
								   OnConfirm="@HandleDrawerConfirm" />
				}
				else
				{
					<div class="empty">
						<Icon Name="IconName.Hexagon" />
						<p class="empty-title">@(_points.Count >= 3 ? T.Regions.BoundaryPoints(_points.Count) : T.Regions.NoBoundary)</p>
						@if (_points.Count == 0)
						{
							<p class="empty-hint">@T.Regions.DrawHint</p>
						}
						<div class="cluster">
							<button type="button" class="btn" @onclick="OpenDrawer">
								<Icon Name="IconName.Edit" />
								@(_points.Count > 0 ? T.Regions.EditBoundary : T.Regions.DrawBoundary)
							</button>
							@if (IsEditMode && _points.Count >= 3)
							{
								<button type="button" class="btn" @onclick="HandleSubmitGeometry">
									<Icon Name="IconName.Save" />
									@T.Regions.SaveBoundary
								</button>
							}
						</div>
					</div>
				}
			</div>
		</div>

		@if (!string.IsNullOrEmpty(_errorMessage))
		{
			<p class="field-error" role="alert">@_errorMessage</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseEditor">@(IsEditMode ? T.Common.Close : T.Common.Cancel)</button>
		@if (!IsEditMode)
		{
			<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!CanSubmit)">
				@T.Common.Create
			</button>
		}
	</Footer>
</ModalShell>
