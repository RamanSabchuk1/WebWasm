<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Vehicles.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
	</div>

	@{ var filteredRows = FilteredVehicles; }
	@if (filteredRows.Length > 0)
	{
		<div class="table-wrap">
			<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="vehicle => vehicle.Id">
				<TemplateColumn Title="@T.Vehicles.Model">
					<HeaderTemplate>
						<SortHeader Title="@T.Vehicles.Model" Key="model" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						<span class="strong">@context.Model</span>
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Vehicles.Registration">
					<HeaderTemplate>
						<SortHeader Title="@T.Vehicles.Registration" Key="registration" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						<span class="nowrap">@context.RegistrationNumber</span>
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Vehicles.Driver">
					@if (context.Driver?.UserInfo is { } driver)
					{
						var driverExpanded = IsDriverExpanded(context.Id);
						<button type="button" class="avatar" @onclick="() => ToggleDriverExpand(context.Id)"
								title="@(driverExpanded ? T.Vehicles.HideDriver : T.Vehicles.ShowDriver)"
								aria-label="@(driverExpanded ? T.Vehicles.HideDriver : T.Vehicles.ShowDriver)"
								aria-expanded="@Aria.State(driverExpanded)">
							<Icon Name="IconName.User" />
							@if (!string.IsNullOrEmpty(context.Driver.Photo))
							{
								@* A broken photo hides itself and the user icon under it shows. *@
								<img src="@context.Driver.Photo" alt="" loading="lazy" onerror="this.hidden = true" />
							}
						</button>
						@if (driverExpanded)
						{
							<dl class="kv driver-info">
								<dt>@T.Vehicles.DriverName</dt>
								<dd>@driver.FirstName @driver.LastName</dd>
								<dt>@T.Common.Phone</dt>
								<dd class="tabular nowrap">@driver.MobilePhone</dd>
							</dl>
						}
					}
					else
					{
						<span class="muted">@T.Vehicles.NoDriver</span>
					}
				</TemplateColumn>
				<TemplateColumn Title="@T.Vehicles.Weight" Align="Align.End">
					<HeaderTemplate>
						<SortHeader Title="@T.Vehicles.Weight" Key="weight" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						@T.FormatNumber((decimal)context.VehicleWeight, 0)
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Vehicles.Capacity" Align="Align.End">
					<HeaderTemplate>
						<SortHeader Title="@T.Vehicles.Capacity" Key="capacity" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						@T.FormatNumber((decimal)context.LoadCapacity, 0)
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Common.Photo">
					@if (!string.IsNullOrEmpty(context.Photo))
					{
						var photoExpanded = IsPhotoExpanded(context.Id);
						<button type="button" class="btn btn-ghost btn-sm" @onclick="() => TogglePhotoExpand(context.Id)" aria-expanded="@Aria.State(photoExpanded)">
							<Icon Name="@(photoExpanded ? IconName.ChevronDown : IconName.Image)" />
							@(photoExpanded ? T.Vehicles.HidePhoto : T.Vehicles.ShowPhoto)
						</button>
						@if (photoExpanded)
						{
							<img src="@context.Photo" alt="@context.Model" class="vehicle-photo" />
						}
					}
					else
					{
						<span class="muted">@T.Vehicles.NoPhoto</span>
					}
				</TemplateColumn>
				<TemplateColumn Title="@T.Common.Actions" Align="Align.End">
					<ActionsDropdown MenuHeight="50">
						<button type="button" class="menu-item menu-item-danger" @onclick="() => OnDelete.InvokeAsync(context)">
							<Icon Name="IconName.Delete" />
							@T.Common.Delete
						</button>
					</ActionsDropdown>
				</TemplateColumn>
			</QuickGrid>
		</div>
		<CustomPaginator State="@_pagination" />
	}
	else if (!Items.Any())
	{
		<div class="empty">
			<Icon Name="IconName.Vehicles" />
			<p class="empty-title">@T.Vehicles.Empty</p>
			<p class="empty-hint">@T.Vehicles.EmptyHint</p>
		</div>
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Search" />
			<p class="empty-title">@T.Common.NothingFound</p>
			<p class="empty-hint">@T.Common.NothingFoundHint</p>
		</div>
	}
</div>
