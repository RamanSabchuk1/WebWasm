<div class="login">
	<div class="login-card">
		<div class="login-header">
			<img class="login-logo" src="logo.svg" alt="" />
			<h1>@T.Login.Title</h1>
			<p class="page-subtitle">@T.Login.Subtitle</p>
		</div>

		<EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="stack">
			<DataAnnotationsValidator />

			<div class="field">
				<label for="username">@T.Login.Login</label>
				<InputText id="username" @bind-Value="_loginModel.Username" placeholder="@T.Login.LoginPlaceholder" autocomplete="username" />
				<ValidationMessage For="@(() => _loginModel.Username)" />
			</div>

			<div class="field">
				<label for="password">@T.Login.Password</label>
				<InputText id="password" type="password" @bind-Value="_loginModel.Password" autocomplete="current-password" />
				<ValidationMessage For="@(() => _loginModel.Password)" />
			</div>

			@if (!string.IsNullOrEmpty(_errorMessage))
			{
				<p class="login-error" role="alert">
					<Icon Name="IconName.Error" />
					<span>@_errorMessage</span>
				</p>
			}

			<button type="submit" class="btn btn-primary btn-block" disabled="@_isLoading">
				@if (_isLoading)
				{
					<span class="spinner"></span>
					<span>@T.Login.SigningIn</span>
				}
				else
				{
					<span>@T.Login.SignIn</span>
				}
			</button>
		</EditForm>
	</div>

	<div class="login-footer">
		<PreferenceSwitches Compact="true" />
		<span class="caption">@Settings.Title(T.Shell.Version(AppSettings.Version))</span>
	</div>
</div>
