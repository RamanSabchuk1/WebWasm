@inherits LeafletMapBase

<div class="triangle-map">
	@if (ShowTitle)
	{
		<p class="cluster caption">
			<Icon Name="IconName.Pin" />
			@T.Enums.LevelType(LevelType)
		</p>
	}
	<div class="map-wrapper" style="--map-height: @MapHeight">
		<div @ref="MapElement" class="leaflet-map"></div>
	</div>
</div>
