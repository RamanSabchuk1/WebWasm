@if (State != null && ResolvedTotalItems.HasValue && TotalPages > 1)
{
	<nav class="pagination" aria-label="@T.Common.PageOf(CurrentPage, TotalPages)">
		<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="GoToFirstPage" disabled="@(!CanGoToPreviousPage())" title="@T.Common.FirstPage" aria-label="@T.Common.FirstPage">
			<Icon Name="IconName.First" />
		</button>
		<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="GoToPreviousPage" disabled="@(!CanGoToPreviousPage())" title="@T.Common.PreviousPage" aria-label="@T.Common.PreviousPage">
			<Icon Name="IconName.ChevronLeft" />
		</button>
		<span class="pagination-state">@T.Common.PageOf(CurrentPage, TotalPages)</span>
		<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="GoToNextPage" disabled="@(!CanGoToNextPage())" title="@T.Common.NextPage" aria-label="@T.Common.NextPage">
			<Icon Name="IconName.ChevronRight" />
		</button>
		<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="GoToLastPage" disabled="@(!CanGoToNextPage())" title="@T.Common.LastPage" aria-label="@T.Common.LastPage">
			<Icon Name="IconName.Last" />
		</button>
	</nav>
}
