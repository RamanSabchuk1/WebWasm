@if (_updateAvailable)
{
	<div class="update-banner" role="status">
		<Icon Name="IconName.Refresh" Size="20" />
		<span class="update-text">@T.Shell.UpdateAvailable</span>
		<button type="button" class="btn btn-primary btn-sm" @onclick="ReloadApp">@T.Shell.UpdateNow</button>
		<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="DismissUpdate" title="@T.Common.Close" aria-label="@T.Common.Close">
			<Icon Name="IconName.Close" />
		</button>
	</div>
}
