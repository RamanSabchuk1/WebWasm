@{ var groups = FilteredGroups; }

<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Devices.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
		@if (groups.Count > 0)
		{
			<div class="cluster">
				<button type="button" class="btn" @onclick="ShowMultiUnbindConfirmation">
					<Icon Name="IconName.Unlink" />
					@T.Devices.UnbindSelected(_selectedTokens.Count)
				</button>
				@if (_selectedTokens.Count > 0)
				{
					<button type="button" class="btn btn-ghost" @onclick="ClearSelection">@T.Devices.ClearSelection</button>
				}
			</div>
		}
	</div>

	@if (groups.Count > 0)
	{
		<div class="groups">
			@foreach (var group in PageOf(groups))
			{
				var duplicates = GetDuplicateDevices(group.Items);
				var groupExpanded = IsGroupExpanded(group.Key);
				var groupName = GroupName(group);
				<section class="group" @key="group.Key">
					<div class="group-header">
						<label class="checkbox" title="@T.Devices.SelectGroup(groupName)">
							<input type="checkbox" checked="@IsGroupFullySelected(group)" @onchange="_ => ToggleSelectGroup(group)" />
							<span class="visually-hidden">@T.Devices.SelectGroup(groupName)</span>
						</label>
						<button type="button" class="btn btn-ghost btn-sm group-toggle" @onclick="() => ToggleGroupExpand(group.Key)" aria-expanded="@Aria.State(groupExpanded)">
							<Icon Name="@(groupExpanded ? IconName.ChevronDown : IconName.ChevronRight)" />
							<span class="strong">@groupName</span>
						</button>
						<span class="caption">@T.Devices.DeviceCount(group.Items.Count)</span>
						@if (duplicates.Count > 0)
						{
							<span class="@Tone.Warning.Badge()" title="@T.Devices.DuplicatesHint">
								<Icon Name="IconName.Warning" />
								@T.Devices.Duplicates
							</span>
						}
					</div>

					@if (groupExpanded)
					{
						<ul class="rows">
							@foreach (var item in group.Items)
							{
								var token = item.DeviceToken;
								var isDuplicate = duplicates.Contains(token.Device.Trim());
								var tokenExpanded = IsExpanded(token.Id);
								var dataExpanded = IsDataExpanded(token.Id);
								<li class="row" @key="token.Id">
									<label class="checkbox" title="@T.Devices.SelectDevice">
										<input type="checkbox" checked="@IsSelected(token.Token)" @onchange="_ => ToggleSelect(token.Token)" />
										<span class="visually-hidden">@T.Devices.SelectDevice</span>
									</label>
									<div class="device">
										<span class="strong">@token.Device</span>
										@if (isDuplicate)
										{
											<span class="@Tone.Warning.Badge()" title="@T.Devices.DuplicatesHint">@T.Devices.Duplicate</span>
										}
									</div>
									<div class="detail">
										<button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleExpand(token.Id)" aria-expanded="@Aria.State(tokenExpanded)">
											<Icon Name="@(tokenExpanded ? IconName.ChevronDown : IconName.ChevronRight)" />
											@T.Devices.Token
										</button>
										@if (tokenExpanded)
										{
											<div class="token">
												<code>@token.Token</code>
												<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => CopyToClipboard(token.Token)"
														title="@T.Common.Copy" aria-label="@T.Common.Copy">
													<Icon Name="IconName.Copy" />
												</button>
											</div>
										}
									</div>
									<div class="detail">
										@if (token.AdditionalData is { Count: > 0 } data)
										{
											<button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleDataExpand(token.Id)" aria-expanded="@Aria.State(dataExpanded)">
												<Icon Name="@(dataExpanded ? IconName.ChevronDown : IconName.ChevronRight)" />
												@T.Devices.DataItems(data.Count)
											</button>
											@if (dataExpanded)
											{
												<dl class="kv data-list">
													@foreach (var kvp in data)
													{
														<dt @key="kvp.Key">@kvp.Key</dt>
														<dd>@kvp.Value</dd>
													}
												</dl>
											}
										}
										else
										{
											<span class="muted small">@T.Devices.NoData</span>
										}
									</div>
									<div class="row-actions">
										<ActionsDropdown MenuHeight="50">
											<button type="button" class="menu-item menu-item-danger"
													@onclick="() => ShowUnbindConfirmation(token.Token, token.UserInfoId, token.Device)">
												<Icon Name="IconName.Unlink" />
												@T.Devices.Unbind
											</button>
										</ActionsDropdown>
									</div>
								</li>
							}
						</ul>
					}
				</section>
			}
		</div>

		<CustomPaginator State="@_pagination" TotalItems="@groups.Count" AfterNavigate="StateHasChanged" />
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Devices" />
			<p class="empty-title">@(string.IsNullOrWhiteSpace(_searchText) ? T.Devices.Empty : T.Common.NothingFound)</p>
		</div>
	}
</div>

<ConfirmDialog IsOpen="@_showConfirmDialog"
			   Title="@_confirmTitle"
			   Message="@_confirmMessage"
			   ConfirmText="@T.Devices.Unbind"
			   OnConfirm="ConfirmUnbind"
			   OnCancel="CancelUnbind" />
