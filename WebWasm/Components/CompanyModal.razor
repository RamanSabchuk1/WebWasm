<ModalShell IsOpen="IsOpen" ContainerClass="modal-lg" Title="@(IsEditMode ? T.Companies.EditTitle : T.Companies.AddTitle)"
			OnClose="CloseModal" OnSubmit="HandleSubmit">
	<ChildContent>
		<section>
			<h3 class="section-title">@T.Companies.Details</h3>
			<div class="form-grid">
				<div class="field">
					<label for="company-name">@T.Common.Name</label>
					<input id="company-name" type="text" @bind="_name" />
				</div>

				<div class="field">
					<label for="company-unp">@T.Companies.Unp</label>
					<input id="company-unp" type="text" @bind="_unp" disabled="@IsEditMode" />
					@if (IsEditMode)
					{
						<span class="hint">@T.Companies.CannotChange</span>
					}
				</div>

				<div class="field span-all">
					<label for="company-address">@T.Common.Address</label>
					<input id="company-address" type="text" @bind="_address" />
				</div>

				<div class="field">
					<label for="company-email">@T.Companies.CorporateEmail</label>
					<input id="company-email" type="email" @bind="_corporateEmail" placeholder="@T.Companies.EmailPlaceholder" />
				</div>

				<div class="field">
					<label for="company-legal-type">@T.Companies.LegalType</label>
					<input id="company-legal-type" type="text" @bind="_legalType" placeholder="@T.Companies.LegalTypePlaceholder" disabled="@IsEditMode" />
					@if (IsEditMode)
					{
						<span class="hint">@T.Companies.CannotChange</span>
					}
				</div>

				<div class="field">
					<label for="company-rebate">@T.Companies.Rebate</label>
					<input id="company-rebate" type="number" step="0.01" min="-100" max="100" @bind="_rebate" />
				</div>

				<div class="field span-all">
					<label for="company-photo">@T.Companies.PhotoUrl</label>
					<input id="company-photo" type="url" @bind="_photo" placeholder="@T.Companies.PhotoUrlPlaceholder" />
					@if (!string.IsNullOrEmpty(_photo))
					{
						<img class="photo-preview" src="@_photo" alt="" />
					}
				</div>
			</div>
		</section>

		<section>
			<h3 class="section-title">@T.Companies.BankAccount</h3>
			<div class="form-grid">
				<div class="field">
					<label for="company-bank-number">@T.Companies.BankNumber</label>
					<input id="company-bank-number" type="text" @bind="_bankNumber" disabled="@IsEditMode" />
				</div>

				<div class="field">
					<label for="company-bic">@T.Companies.Bic</label>
					<input id="company-bic" type="text" @bind="_bic" disabled="@IsEditMode" />
				</div>
			</div>
			@if (IsEditMode)
			{
				<p class="hint">@T.Companies.CannotChange</p>
			}
		</section>

		<section>
			<h3 class="section-title">@T.Companies.Location</h3>
			<LocationMapPicker InitialLocation="@_location" OnLocationChanged="HandleLocationChanged" />
		</section>

		@if (_showErrors && !IsValid)
		{
			<p class="field-error" role="alert">@T.Companies.FillRequired</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!IsValid)">
			@(IsEditMode ? T.Common.Save : T.Common.Create)
		</button>
	</Footer>
</ModalShell>
