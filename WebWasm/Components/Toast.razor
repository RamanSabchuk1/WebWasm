@if (_messages.Count > 0)
{
	<div class="toast-stack" role="status" aria-live="polite">
		@foreach (var message in _messages)
		{
			<div class="toast toast-@message.Type.ToString().ToLowerInvariant()" @key="message">
				<Icon Name="IconOf(message.Type)" Size="20" />
				<span class="toast-text">@message.Text</span>
				<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => RemoveMessage(message)" title="@T.Common.Close" aria-label="@T.Common.Close">
					<Icon Name="IconName.Close" />
				</button>
			</div>
		}
	</div>
}
