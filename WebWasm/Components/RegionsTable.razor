<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Regions.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
	</div>

	@{ var filteredRows = FilteredRegions; }
	@if (filteredRows.Count > 0)
	{
		<div class="table-wrap">
			<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="region => region.Id">
				<TemplateColumn Title="@T.Common.Name">
					<HeaderTemplate>
						<SortHeader Title="@T.Common.Name" Key="name" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						<span class="strong">@context.Name</span>
					</ChildContent>
				</TemplateColumn>
				<TemplateColumn Title="@T.Regions.Levels">
					@{ var types = GetLevelTypes(context); }
					@if (types.Count > 0)
					{
						<div class="cluster">
							@foreach (var type in types)
							{
								<span class="badge badge-neutral" @key="type">@T.Enums.LevelType(type)</span>
							}
						</div>
					}
					else
					{
						<span class="muted">@Texts.Dash</span>
					}
				</TemplateColumn>
				<TemplateColumn Title="@T.Common.Actions" Align="Align.End">
					<ActionsDropdown MenuHeight="130">
						<button type="button" class="menu-item" @onclick="() => OnView.InvokeAsync(context)">
							<Icon Name="IconName.Eye" />
							@T.Common.Details
						</button>
						<button type="button" class="menu-item" @onclick="() => OnEdit.InvokeAsync(context)">
							<Icon Name="IconName.Edit" />
							@T.Common.Edit
						</button>
						<div class="menu-separator"></div>
						<button type="button" class="menu-item menu-item-danger" @onclick="() => OnDelete.InvokeAsync(context)">
							<Icon Name="IconName.Delete" />
							@T.Common.Delete
						</button>
					</ActionsDropdown>
				</TemplateColumn>
			</QuickGrid>
		</div>
		<CustomPaginator State="@_pagination" />
	}
	else if (_hasItems)
	{
		<div class="empty">
			<Icon Name="IconName.Search" />
			<p class="empty-title">@T.Common.NothingFound</p>
			<p class="empty-hint">@T.Common.NothingFoundHint</p>
		</div>
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Regions" />
			<p class="empty-title">@T.Regions.Empty</p>
			<p class="empty-hint">@T.Regions.EmptyHint</p>
		</div>
	}
</div>
