<ModalShell IsOpen="IsOpen" Title="@(IsEditMode ? T.Regions.EditTitle : T.Regions.AddTitle)" OnClose="CloseModal" OnSubmit="HandleSubmit">
	<ChildContent>
		<div class="field">
			<label for="region-name">@T.Common.Name</label>
			<input id="region-name" type="text" @bind="_name" placeholder="@T.Regions.NamePlaceholder" />
		</div>

		<div class="field">
			<label for="region-time-zone">@T.Regions.TimeZone</label>
			<input id="region-time-zone" type="text" @bind="_timeZone" />
			<span class="hint">@T.Regions.TimeZoneHint</span>
		</div>

		@if (IsEditMode && _existingLevels.Count > 0)
		{
			<div>
				<h3 class="section-title">@T.Regions.Levels</h3>
				<div class="stack">
					@foreach (var level in _existingLevels)
					{
						<div class="cluster" @key="level.Id">
							<span class="badge badge-neutral">@T.Enums.LevelType(level.Type)</span>
							<span class="caption">@T.Regions.LevelSummary(T.Regions.AlgorithmName(level.CalculationAlgorithm), level.Triangles?.Count ?? 0)</span>
						</div>
					}
				</div>
			</div>
		}

		@if (!string.IsNullOrEmpty(_errorMessage))
		{
			<p class="field-error" role="alert">@_errorMessage</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!IsValid)">
			@(IsEditMode ? T.Common.Save : T.Common.Create)
		</button>
	</Footer>
</ModalShell>
