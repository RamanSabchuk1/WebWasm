@* Bell of the push subscription. Taps are handled by the JS module (PushSubscription.razor.js): on iPhone the
   permission request works only inside the tap handler itself. *@
<div class="bell-wrap">
	<button @ref="_button" type="button" class="btn bell @(_state == PushState.On ? "is-on" : null)"
			disabled="@(!CanTap)" title="@Title" aria-label="@Title">
		@if (_state is PushState.Checking or PushState.Subscribing)
		{
			<span class="spinner" role="status"></span>
		}
		else
		{
			<Icon Name="@(_state is PushState.On or PushState.Ready ? IconName.Bell : IconName.BellOff)" Size="20" />
		}
	</button>
	<span class="bell-caption">@Caption</span>
	@if (Hint is not null)
	{
		<p class="bell-hint">@Hint</p>
	}
</div>
