<ModalShell IsOpen="IsOpen" ContainerClass="modal-lg" Title="@(IsEditMode ? T.Providers.EditTitle : T.Providers.AddTitle)"
			OnClose="CloseModal" OnSubmit="HandleSubmit">
	<ChildContent>
		<div class="form-grid">
			<div class="field">
				<label for="producer-name">@T.Common.Name</label>
				<input id="producer-name" type="text" @bind="_name" disabled="@IsEditMode" />
				@if (IsEditMode)
				{
					<span class="hint">@T.Providers.NameLocked</span>
				}
			</div>

			<div class="field">
				<label for="producer-company">@T.Common.Company</label>
				<select id="producer-company" @bind="_companyId" disabled="@IsEditMode">
					<option value="">@T.Providers.NoCompany</option>
					@foreach (var company in Companies)
					{
						<option value="@company.Id" @key="company.Id">@company.Name</option>
					}
				</select>
				@if (IsEditMode)
				{
					<span class="hint">@T.Providers.CompanyLocked</span>
				}
			</div>
		</div>

		<section>
			<div class="card-header">
				<h3 class="card-title">@T.Providers.WorkingHours</h3>
				<button type="button" class="btn btn-sm" @onclick="AddWorkingTimeEntry">
					<Icon Name="IconName.Plus" />
					@T.Providers.AddWorkingTime
				</button>
			</div>

			@if (_workingTimeEntries.Count == 0)
			{
				<div class="empty">
					<Icon Name="IconName.Clock" />
					<p class="empty-title">@T.Providers.NoWorkingTimes</p>
					<p class="empty-hint">@T.Providers.NoWorkingTimesHint</p>
				</div>
			}
			else
			{
				<div class="stack">
					@for (int i = 0; i < _workingTimeEntries.Count; i++)
					{
						var entry = _workingTimeEntries[i];
						var index = i;
						var prefix = $"producer-time-{index}";

						<div class="entry" @key="entry">
							<div class="entry-header">
								<span class="strong">@T.Providers.Entry(index + 1)</span>
								<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => RemoveWorkingTimeEntry(index)"
										title="@T.Providers.RemoveEntry" aria-label="@T.Providers.RemoveEntry">
									<Icon Name="IconName.Delete" />
								</button>
							</div>

							<div class="form-grid entry-fields">
								<div class="field">
									<label for="@($"{prefix}-day")">@T.Providers.Weekday</label>
									<select id="@($"{prefix}-day")" @bind="entry.DayOfWeek">
										@foreach (var day in Enum.GetValues<DayOfWeek>())
										{
											<option value="@day" @key="day">@T.Providers.DayName(day)</option>
										}
									</select>
								</div>

								<div class="field">
									<label for="@($"{prefix}-loading-start")">@T.Providers.LoadingStart</label>
									<input id="@($"{prefix}-loading-start")" type="time" @bind="entry.StartLoadingHours" />
								</div>

								<div class="field">
									<label for="@($"{prefix}-loading-end")">@T.Providers.LoadingEnd</label>
									<input id="@($"{prefix}-loading-end")" type="time" @bind="entry.EndLoadingHours" />
								</div>

								<div class="field">
									<label for="@($"{prefix}-working-start")">@T.Providers.WorkingStart</label>
									<input id="@($"{prefix}-working-start")" type="time" @bind="entry.StartWorkingHours" />
								</div>

								<div class="field">
									<label for="@($"{prefix}-working-end")">@T.Providers.WorkingEnd</label>
									<input id="@($"{prefix}-working-end")" type="time" @bind="entry.EndWorkingHours" />
								</div>
							</div>
						</div>
					}
				</div>
			}
		</section>

		@if (_showErrors && !IsValid)
		{
			<p class="field-error" role="alert">@T.Providers.FillRequired</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!IsValid)">
			@(IsEditMode ? T.Common.Save : T.Common.Create)
		</button>
	</Footer>
</ModalShell>
