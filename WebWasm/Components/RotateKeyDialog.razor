@* Enter = rotate, Escape = cancel. *@
<ModalShell IsOpen="IsOpen" ContainerClass="modal-sm" Title="@T.Keys.RotateTitle" OnClose="CloseModal" OnSubmit="HandleConfirm">
	<ChildContent>
		<p>@T.Keys.RotateMessage(T.Enums.EncryptionPurpose(Purpose))</p>

		<label class="checkbox">
			<input type="checkbox" checked="@_force" @onchange="OnForceChanged" />
			<span>@T.Keys.Force</span>
		</label>

		@if (_force)
		{
			<p class="force-warning warning-text small" role="alert">
				<Icon Name="IconName.Warning" />
				<span>@T.Keys.ForceWarning</span>
			</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleConfirm">
			<Icon Name="IconName.Rotate" />
			@T.Keys.RotateKey
		</button>
	</Footer>
</ModalShell>
