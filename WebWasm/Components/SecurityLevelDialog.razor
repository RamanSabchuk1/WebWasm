<ModalShell IsOpen="IsOpen && _loaded" ContainerClass="modal-sm" Title="@T.Security.Title" OnClose="CloseModal" OnSubmit="HandleSubmit">
	<ChildContent>
		@if (!string.IsNullOrEmpty(EntityLabel))
		{
			<p class="strong">@EntityLabel</p>
		}

		<div class="field">
			<label for="security-level">@T.Security.Level</label>
			<select id="security-level" @bind="_selectedLevel">
				@foreach (var level in _levels)
				{
					<option value="@level" @key="level">@T.Enums.SecurityLevel(level)</option>
				}
			</select>
		</div>

		<div>
			<h3 class="section-title">@T.Security.WhatItMeans</h3>
			<p class="muted">@T.Security.Description(_selectedLevel)</p>
		</div>

		@if (_selectedLevel != _currentLevel)
		{
			<p class="change-note" role="status">
				<Icon Name="IconName.Info" />
				<span>@T.Security.Change(T.Enums.SecurityLevel(_currentLevel), T.Enums.SecurityLevel(_selectedLevel))</span>
			</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="CloseModal">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(_selectedLevel == _currentLevel)">@T.Common.Save</button>
	</Footer>
</ModalShell>
