<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Providers.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
	</div>

	@{ var filteredRows = FilteredProducers; }
	@if (filteredRows.Count > 0)
	{
		<div class="table-wrap">
			<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="producer => producer.Id">
				<TemplateColumn Title="@T.Providers.Supplier">
					@{ var expanded = IsProducerExpanded(context.Id); }
					<div class="name-cell">
						<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => ToggleProducerExpand(context.Id)"
								title="@(expanded ? T.Common.Collapse : T.Common.Expand)" aria-label="@(expanded ? T.Common.Collapse : T.Common.Expand)"
								aria-expanded="@Aria.State(expanded)">
							<Icon Name="@(expanded ? IconName.ChevronDown : IconName.ChevronRight)" />
						</button>
						<div class="name-main">
							<span class="strong">@context.Name</span>
							<span class="caption">@(context.Company?.Name ?? T.Providers.NoCompany)</span>
						</div>
					</div>

					@if (expanded)
					{
						var hoursExpanded = IsWorkingTimeExpanded(context.Id);
						var placesExpanded = IsLoadingPlacesExpanded(context.Id);
						<div class="details">
							<div class="details-head">
								<button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleWorkingTimeExpand(context.Id)" aria-expanded="@Aria.State(hoursExpanded)">
									<Icon Name="@(hoursExpanded ? IconName.ChevronDown : IconName.ChevronRight)" />
									@T.Providers.WorkingHoursCount(context.ProducerWorkingTime.Count)
								</button>
							</div>

							@if (hoursExpanded && context.ProducerWorkingTime.Count > 0)
							{
								<table class="table hours">
									<thead>
										<tr>
											<th>@T.Providers.Day</th>
											<th>@T.Providers.LoadingHours</th>
											<th>@T.Providers.WorkingHours</th>
										</tr>
									</thead>
									<tbody>
										@* An index key: two entries of one day with the same hours are possible, a value key would throw. *@
										@foreach (var row in SortedWorkingTimes(context))
										{
											var wt = row.Time;
											<tr @key="row.Index">
												<td>@T.Providers.DayShort(wt.DayOfWeek)</td>
												<td class="tabular nowrap">@T.Providers.TimeRange(Time(wt.StartLoadingHours), Time(wt.EndLoadingHours))</td>
												<td class="tabular nowrap">@T.Providers.TimeRange(Time(wt.StartWorkingHours), Time(wt.EndWorkingHours))</td>
											</tr>
										}
									</tbody>
								</table>
							}

							<div class="details-head">
								<button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleLoadingPlacesExpand(context.Id)" aria-expanded="@Aria.State(placesExpanded)">
									<Icon Name="@(placesExpanded ? IconName.ChevronDown : IconName.ChevronRight)" />
									@T.Providers.LoadingPlacesCount(context.LoadingPlaces.Count)
								</button>
								<button type="button" class="btn btn-sm" @onclick="() => OnAddLoadingPlace.InvokeAsync(context)">
									<Icon Name="IconName.Plus" />
									@T.Providers.AddPlace
								</button>
							</div>

							@if (placesExpanded && context.LoadingPlaces.Count > 0)
							{
								<ul class="places">
									@foreach (var place in context.LoadingPlaces)
									{
										<li class="place" @key="place.Id">
											<div class="place-main">
												<span class="strong">@place.Name</span>
												<span class="caption tabular">
													<Icon Name="IconName.Pin" />
													@T.Providers.Coordinates(T.FormatNumber(place.Location.Latitude, 6), T.FormatNumber(place.Location.Longitude, 6))
												</span>
												<dl class="place-facts">
													<div>
														<dt>@T.Providers.Cost</dt>
														<dd class="tabular">@T.FormatMoney(place.Cost)</dd>
													</div>
													<div>
														<dt>@T.Providers.Volume</dt>
														<dd class="tabular">@T.Providers.VolumeValue(T.FormatNumber((decimal)place.Volume, 0))</dd>
													</div>
													@if (place.MaterialType is not null)
													{
														<div>
															<dt>@T.Providers.Material</dt>
															<dd class="material">
																@if (!string.IsNullOrEmpty(place.MaterialType.Photo))
																{
																	<img src="@place.MaterialType.Photo" alt="" class="material-thumb" loading="lazy" />
																}
																@place.MaterialType.Name
															</dd>
														</div>
													}
												</dl>
											</div>
											<ActionsDropdown MenuHeight="90">
												<button type="button" class="menu-item" @onclick="() => OnEditLoadingPlace.InvokeAsync((context.Id, place))">
													<Icon Name="IconName.Edit" />
													@T.Common.Edit
												</button>
												<button type="button" class="menu-item menu-item-danger" @onclick="() => OnDeleteLoadingPlace.InvokeAsync((context.Id, place.Id))">
													<Icon Name="IconName.Delete" />
													@T.Common.Delete
												</button>
											</ActionsDropdown>
										</li>
									}
								</ul>
							}
						</div>
					}
				</TemplateColumn>

				<TemplateColumn Title="@T.Common.Actions" Align="Align.End">
					<ActionsDropdown MenuHeight="90">
						<button type="button" class="menu-item" @onclick="() => OnEditProducer.InvokeAsync(context)">
							<Icon Name="IconName.Edit" />
							@T.Common.Edit
						</button>
						<button type="button" class="menu-item menu-item-danger" @onclick="() => OnDeleteProducer.InvokeAsync(context.Id)">
							<Icon Name="IconName.Delete" />
							@T.Common.Delete
						</button>
					</ActionsDropdown>
				</TemplateColumn>
			</QuickGrid>
		</div>
		<CustomPaginator State="@_pagination" />
	}
	else if (Producers.Count == 0)
	{
		<div class="empty">
			<Icon Name="IconName.Providers" />
			<p class="empty-title">@T.Providers.Empty</p>
			<p class="empty-hint">@T.Providers.EmptyHint</p>
		</div>
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Search" />
			<p class="empty-title">@T.Common.NothingFound</p>
			<p class="empty-hint">@T.Common.NothingFoundHint</p>
		</div>
	}
</div>
