@* Enter = confirm, Escape = cancel. *@
<ModalShell IsOpen="IsOpen" ContainerClass="modal-sm" TopLayer="true" Title="@(Title ?? T.Common.ConfirmDeleteTitle)"
			OnClose="() => OnCancel.InvokeAsync()" OnSubmit="() => OnConfirm.InvokeAsync()">
	<ChildContent>
		<p>@Message</p>
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="() => OnCancel.InvokeAsync()">@(CancelText ?? T.Common.Cancel)</button>
		<button type="button" class="btn @(IsDangerous ? "btn-danger" : "btn-primary")" @onclick="() => OnConfirm.InvokeAsync()">@(ConfirmText ?? T.Common.Delete)</button>
	</Footer>
</ModalShell>
