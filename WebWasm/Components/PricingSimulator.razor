<div class="card">
	<div class="card-header">
		<h2 class="card-title">@T.Simulator.Participants</h2>
	</div>
	<div class="stack">
		<div class="form-grid">
			<div class="field">
				<label for="sim-loading-place">@T.Simulator.LoadingPlace <span class="caption">@T.Simulator.Required</span></label>
				<select id="sim-loading-place" value="@(_loadingPlaceId?.ToString() ?? "")" @onchange="OnLoadingPlaceChanged">
					<option value="">@T.Simulator.ChooseLoadingPlace</option>
					@foreach (var group in (_options?.LoadingPlaces ?? []).GroupBy(x => x.CompanyName))
					{
						<optgroup label="@group.Key" @key="group.Key">
							@foreach (var place in group)
							{
								<option value="@place.Id" @key="place.Id">@PlaceLabel(place)</option>
							}
						</optgroup>
					}
				</select>
			</div>
			<div class="field">
				<label for="sim-carrier">@T.Simulator.Carrier <span class="caption">@T.Simulator.Optional</span></label>
				<select id="sim-carrier" value="@(_carrierId?.ToString() ?? "")" @onchange="OnCarrierChanged">
					<option value="">@T.Simulator.NoCarrier</option>
					@foreach (var company in Carriers)
					{
						<option value="@company.Id" @key="company.Id">@company.Name</option>
					}
				</select>
			</div>
			<div class="field">
				<label for="sim-buyer">@T.Simulator.Buyer <span class="caption">@T.Simulator.Optional</span></label>
				<select id="sim-buyer" value="@(_buyerId?.ToString() ?? "")" @onchange="OnBuyerChanged">
					<option value="">@T.Simulator.NoBuyer</option>
					@foreach (var company in Buyers)
					{
						<option value="@company.Id" @key="company.Id">@company.Name</option>
					}
				</select>
			</div>
			<div class="field">
				<label for="sim-region">@T.Common.Region</label>
				<select id="sim-region" value="@(_regionId?.ToString() ?? "")" @onchange="OnRegionChanged">
					<option value="">@T.Simulator.ChooseRegion</option>
					@foreach (var region in _options?.Regions ?? [])
					{
						<option value="@region.Id" @key="region.Id">@region.Name</option>
					}
				</select>
			</div>
		</div>
		@if (_loadingPlaceId is null)
		{
			<p class="hint">@T.Simulator.NeedLoadingPlace</p>
		}
		else if (_regionId is null)
		{
			<p class="hint">@T.Simulator.NeedRegion</p>
		}
	</div>
</div>

@if (_result is { } result)
{
	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Simulator.ResolvedTitle</h2>
			@if (OverrideCount > 0)
			{
				<button type="button" class="btn btn-sm" @onclick="ClearOverrides">
					<Icon Name="IconName.Undo" />
					@T.Simulator.ClearOverrides(OverrideCount)
				</button>
			}
		</div>
		<div class="stack">
			<p class="hint">@T.Simulator.ResolvedHint</p>
			<div class="src-legend" role="list" aria-label="@T.Simulator.SourceLegend">
				<span role="listitem" class="src-chip src-default">@T.Simulator.SourceDefault</span>
				<span role="listitem" class="src-chip src-global">@T.Simulator.SourceGlobal</span>
				<span role="listitem" class="src-chip src-material-0">@T.Simulator.SourceMaterial</span>
				<span role="listitem" class="src-chip src-material-1">@T.Simulator.SourceParentMaterial</span>
				<span role="listitem" class="src-chip src-supplier">@T.Simulator.SourceSupplier</span>
				<span role="listitem" class="src-chip src-carrier">@T.Simulator.SourceCarrier</span>
				<span role="listitem" class="src-chip src-buyer">@T.Simulator.SourceBuyer</span>
				<span role="listitem" class="src-chip src-override">@T.Simulator.SourceOverride</span>
			</div>

			<div class="res-groups">
				@foreach (var group in Groups)
				{
					var rows = RowsOf(group);
					if (rows.Length == 0)
					{
						continue;
					}

					<section class="res-group" @key="group.Title">
						<div class="res-group-head">
							<h3 class="res-title">@group.Title</h3>
							<span class="hint">@group.Hint</span>
						</div>
						<div class="res-grid" style="--cols:@group.Columns.Length">
							@if (group.Columns.Length > 1)
							{
								<div class="res-colhead"></div>
								@foreach (var column in group.Columns)
								{
									<div class="res-colhead" @key="column.Id">
										<span class="strong">@column.Stage</span>
										@if (ColumnNote(column.Id) is { } note)
										{
											<span class="res-colnote">@note</span>
										}
									</div>
								}
							}
							@foreach (var setting in rows)
							{
								var cells = CellsOf(setting, group);
								<div class="res-key" title="@setting.Description" @key="(setting.Key, -1)"><code>@setting.Key</code></div>
								@foreach (var (start, length) in PriceChartMath.Runs(cells, SameCell))
								{
									var cell = cells[start];
									if (cell is null)
									{
										<div class="res-cell res-empty" @key="(setting.Key, start)" style="--span: @length" title="@T.Simulator.KeyNotRead">
											<span aria-hidden="true">@Texts.Dash</span>
											<span class="visually-hidden">@T.Simulator.KeyNotRead</span>
										</div>
									}
									else
									{
										<button type="button" class="res-cell @SourceClass(cell)" @key="(setting.Key, start)" style="--span: @length"
												data-label="@StagesOf(group, start, length)" title="@cell.Note" @onclick="() => OpenEdit(setting, Merged(cells, start, length))">
											<span class="res-line">
												<span class="res-value">@T.Pricing.Value(cell.Value)</span>
												<span class="res-source">@cell.Source.Name</span>
											</span>
											@if (ChangedFromSaved(cell))
											{
												<span class="res-saved">@T.Simulator.Was(T.Pricing.Value(cell.SavedValue), cell.SavedSource.Name)</span>
											}
											@if (cell.Note is not null)
											{
												<span class="res-note">@cell.Note</span>
											}
										</button>
									}
								}
							}
						</div>
					</section>
				}
			</div>

			@if (_overrides.Count > 0)
			{
				<div class="cluster">
					<span class="caption">@T.Simulator.OverridesTitle</span>
					@foreach (var view in _overrides)
					{
						<span class="sim-chip" @key="(view.Override.Key, view.Override.Scope, view.Override.ScopeId)">
							<code>@view.Override.Key</code>
							@T.Simulator.OverrideChip(T.Pricing.Number(view.Override.Value), view.ScopeName)
							<button type="button" class="btn btn-ghost btn-icon btn-sm" title="@T.Simulator.RemoveOverride" aria-label="@T.Simulator.RemoveOverride"
									@onclick="() => RemoveOverride(view)">
								<Icon Name="IconName.Close" />
							</button>
						</span>
					}
				</div>
			}

			<section class="res-group stack">
				<div class="res-group-head">
					<h3 class="res-title">@T.Simulator.RegionTitle</h3>
					@if (_regionPrices.Count > 0)
					{
						<button type="button" class="btn btn-sm" @onclick="ClearRegionPrices">
							<Icon Name="IconName.Undo" />
							@T.Simulator.ResetRegionPrices(_regionPrices.Count)
						</button>
					}
				</div>
				<p class="hint">@T.Simulator.RegionHint</p>
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th>@T.Capacities.Weight</th>
								<th class="num">@T.Simulator.CityColumn</th>
								<th class="num">@T.Simulator.SuburbColumn</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var row in result.RegionPrices)
							{
								<tr @key="row.WeightKg">
									<td class="strong nowrap">@T.Pricing.KgAsTons(row.WeightKg)</td>
									@foreach (var (level, price) in new[] { (City, row.City), (Neighborhood, row.Neighborhood) })
									{
										if (price is null)
										{
											<td class="num" @key="level">
												<button type="button" class="price-btn danger-text" @onclick="() => OpenRegionPrice(row.WeightKg, level, null)">
													<Icon Name="IconName.Edit" />
													@T.Simulator.NoPriceCell
												</button>
											</td>
										}
										else
										{
											<td class="num @PriceClass(price)" @key="level">
												<button type="button" class="price-btn" title="@PriceTitle(price)" @onclick="() => OpenRegionPrice(row.WeightKg, level, price)">
													@Money(price.Min) – @Money(price.Max)
												</button>
											</td>
										}
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="hint">
					@T.Simulator.RangesHint(T.Pricing.Minutes(result.Ranges.MinMinutes), T.Pricing.Minutes(result.Ranges.MaxMinutes),
						T.Pricing.Speed(result.Ranges.SpeedCityKmh), T.Pricing.Km(result.Ranges.MinKm), T.Pricing.Km(result.Ranges.MaxKm))
				</p>
			</section>
		</div>
	</div>
}

@if (_loadingPlaceId is not null && _regionId is not null)
{
	<div class="card">
		<div class="card-header">
			<h2 class="card-title">@T.Simulator.ChartTitle</h2>
			@if (_busy)
			{
				<span class="cluster small muted" role="status">
					<span class="spinner"></span>
					@T.Simulator.Computing
				</span>
			}
		</div>

		<div class="stack">
			<div class="cluster">
				<button type="button" class="btn btn-sm @(ParamChanged(ParamKind.MaterialCost) ? "param-changed" : null)" @onclick="() => OpenParam(ParamKind.MaterialCost)">
					<Icon Name="IconName.Edit" />
					@T.Simulator.MaterialParam(Money(_result?.MaterialCostPerTon ?? LoadingPlace?.CostPerTon ?? 0))
				</button>
				<button type="button" class="btn btn-sm @(ParamChanged(ParamKind.SupplierRebate) ? "param-changed" : null)" @onclick="() => OpenParam(ParamKind.SupplierRebate)">
					<Icon Name="IconName.Edit" />
					@T.Simulator.SupplierRebateParam(T.Pricing.Percent(_result?.SupplierRebatePercent ?? 0))
				</button>
				@if (_carrierId is not null)
				{
					<button type="button" class="btn btn-sm @(ParamChanged(ParamKind.CarrierRebate) ? "param-changed" : null)" @onclick="() => OpenParam(ParamKind.CarrierRebate)">
						<Icon Name="IconName.Edit" />
						@T.Simulator.CarrierRebateParam(T.Pricing.Percent(_result?.CarrierRebatePercent ?? 0))
					</button>
				}
			</div>

			@if (_result is { } r)
			{
				var ranges = r.Ranges;
				var slot = SlotWindow();
				<div class="sliders">
					<div class="slider">
						<div class="slider-head">
							<label for="sim-weight">@T.Simulator.OrderWeight</label>
							<strong class="tabular">@T.Pricing.Tons(_weightTons)</strong>
						</div>
						<input id="sim-weight" type="range" min="@Inv(ranges.MinTons)" max="@Inv(ranges.MaxTons)" step="1" value="@Inv(_weightTons)" @oninput="OnWeightInput" />
						<div class="hint">
							@T.Simulator.WeightHint(ProgressionText)
							<span class="truck-list">
								@foreach (var s in r.Series.Where(s => s.WeightKg > 0 && s.BuyerHasCompany))
								{
									<span @key="s.WeightKg">@T.Pricing.KgAsTons(s.WeightKg) × @s.Deliveries = @T.Pricing.Tons(s.Tons): @VolumeEffect(s.Deliveries, s.VolumeFactor, s.VolumeMultiplier)</span>
								}
							</span>
						</div>
					</div>

					<div class="slider">
						<div class="slider-head">
							<div class="segmented path-switch" role="group" aria-label="@T.Simulator.PathModeLabel">
								<button type="button" aria-pressed="@Aria.State(IsDuration)" @onclick="() => SetPathMode(Duration)">@T.Simulator.PathDuration</button>
								<button type="button" aria-pressed="@Aria.State(!IsDuration)" @onclick="() => SetPathMode(Distance)">@T.Simulator.PathDistance</button>
							</div>
							<strong class="tabular">@(IsDuration ? T.Pricing.Minutes(_minutes) : T.Pricing.Km(_km))</strong>
						</div>
						<div class="range-wrap">
							@if (IsDuration)
							{
								<input type="range" aria-label="@T.Simulator.PathDuration" min="0" max="@Inv(ranges.MinutesLimit)" step="1" value="@Inv(_minutes)" @oninput="OnPathInput" />
								<span class="mark" style="--at: @MarkLeft(ranges.MinMinutes, 0, ranges.MinutesLimit)" title="@T.Simulator.CityMinMark"></span>
								<span class="mark" style="--at: @MarkLeft(ranges.MaxMinutes, 0, ranges.MinutesLimit)" title="@T.Simulator.CityMaxMark"></span>
							}
							else
							{
								<input type="range" aria-label="@T.Simulator.PathDistance" min="0" max="@Inv(ranges.KmLimit)" step="1" value="@Inv(_km)" @oninput="OnPathInput" />
								<span class="mark" style="--at: @MarkLeft(ranges.MinKm, 0, ranges.KmLimit)" title="@T.Simulator.SuburbMinMark"></span>
								<span class="mark" style="--at: @MarkLeft(ranges.MaxKm, 0, ranges.KmLimit)" title="@T.Simulator.SuburbMaxMark"></span>
							}
						</div>
						<div class="hint">
							@(IsDuration
								? T.Simulator.CityMarks(T.Pricing.Minutes(ranges.MinMinutes), T.Pricing.Minutes(ranges.MaxMinutes))
								: T.Simulator.SuburbMarks(T.Pricing.Km(ranges.MinKm), T.Pricing.Km(ranges.MaxKm)))
							@T.Simulator.SecondValueHint(T.Pricing.Number(ranges.Circuity, 2), T.Pricing.Speed(ranges.SpeedKmh))
						</div>
						@if (slot is { } win)
						{
							<div class="slot-line" title="@T.Simulator.SlotTitle">
								@T.Simulator.SlotFormula(T.Pricing.Minutes(win.Minutes), T.Pricing.Number(win.Minutes, 1), T.Pricing.Number(r.Slot.PreparationMinutes, 1),
									T.Pricing.Number(r.Slot.RoundTripFactor, 2), T.Pricing.Number(r.Slot.TrafficBuffer, 2), T.Pricing.Number(win.Trip, 1),
									T.Pricing.Number(r.Slot.LoadingMinutes, 1))
								<strong>@T.Pricing.Minutes(win.Window)</strong>
								@T.Simulator.SlotTail(T.Pricing.Minutes(r.Slot.MinSlotMinutes))
							</div>
						}
					</div>

					<div class="slider">
						<div class="slider-head">
							<label for="sim-progression">@T.Simulator.Progression</label>
							<strong class="tabular">@ProgressionLabel</strong>
						</div>
						<input id="sim-progression" type="range" min="-1" max="1" step="0.05" value="@Inv(_progressionDraft)" @oninput="OnProgressionInput" @onchange="OnProgressionChange" />
						<div class="hint">
							@if (Math.Round(_progressionDraft, 2) == 0)
							{
								@(T.Simulator.ProgressionOff + " ")
							}
							@T.Simulator.ProgressionHint
						</div>
						@if (_progression is not null)
						{
							<button type="button" class="btn btn-link small" @onclick="ResetProgression">
								<Icon Name="IconName.Undo" />
								@T.Simulator.RestoreSaved
							</button>
						}
					</div>
				</div>

				<PriceChart Result="r" HasCarrier="_carrierId is not null" @bind-CarrierView="_carrierView" PointSelected="OnPointSelected" />

				<section class="stack custom-order">
					<h3 class="res-title">@T.Simulator.CustomTitle</h3>
					<p class="hint">@T.Simulator.CustomHint</p>
					<div class="cluster">
						@foreach (var weight in _options?.Weights ?? [])
						{
							<button type="button" class="btn btn-sm" @key="weight" disabled="@(_custom.Count >= MaxCustomDeliveries)"
									title="@T.Simulator.AddDelivery(T.Pricing.KgAsTons(weight))" @onclick="() => AddDelivery(weight)">
								<Icon Name="IconName.Plus" />
								@T.Pricing.KgAsTons(weight)
							</button>
						}
						@if (_custom.Count > 0)
						{
							<button type="button" class="btn btn-ghost btn-sm" @onclick="ClearDeliveries">
								<Icon Name="IconName.Delete" />
								@T.Common.Clear
							</button>
						}
					</div>
					@if (_custom.Count > 0)
					{
						<div class="cluster">
							@for (var i = 0; i < _custom.Count; i++)
							{
								var index = i;
								<span class="sim-chip" @key="index">
									@T.Pricing.KgAsTons(_custom[index])
									<button type="button" class="btn btn-ghost btn-icon btn-sm" title="@T.Simulator.RemoveDelivery" aria-label="@T.Simulator.RemoveDelivery"
											@onclick="() => RemoveDelivery(index)">
										<Icon Name="IconName.Close" />
									</button>
								</span>
							}
						</div>
						<div class="table-wrap">
							<table>
								<thead>
									<tr>
										<th>@T.Simulator.Buyer</th>
										<th>@T.Simulator.CityShare</th>
										<th class="num">@T.Simulator.TotalColumn</th>
										<th class="num">@T.Simulator.MaterialColumn</th>
										<th class="num">@T.Simulator.DeliveriesColumn</th>
										@if (_carrierId is not null)
										{
											<th class="num">@T.Simulator.CarrierGetsColumn</th>
										}
										<th class="num">@T.Simulator.CommissionColumn</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var order in r.Series.Where(s => s.WeightKg == 0))
									{
										<tr @key="order.BuyerHasCompany">
											<td class="nowrap">@T.Pricing.Buyer(order.BuyerHasCompany)</td>
											@if (order.Error is not null || order.Points.Length == 0)
											{
												<td colspan="@(_carrierId is null ? 5 : 6)" class="danger-text">@T.Pricing.NoPrice</td>
											}
											else
											{
												var p = order.Points[SelectedIndex(order)];
												<td class="nowrap tabular">@T.Pricing.Share(p.TMode) · @T.Pricing.Km(p.Km) · @T.Pricing.Minutes(p.Minutes)</td>
												<td class="num strong">@Money(p.Total)</td>
												<td class="num">@Money(p.Material)</td>
												<td class="num nowrap">
													@Money(p.Delivery)
													<span class="caption">(@(string.Join(" + ", (p.DeliveryPrices ?? []).Select(Money))))</span>
												</td>
												@if (_carrierId is not null)
												{
													<td class="num nowrap">
														@(p.CarrierDelivery is { } carrierDelivery ? Money(carrierDelivery) : Texts.Dash)
														<span class="caption">(@(string.Join(" + ", (p.CarrierDeliveryPrices ?? []).Select(Money))))</span>
													</td>
												}
												<td class="num">@Money(_carrierView && p.CarrierCommission is { } carrierCommission ? carrierCommission : p.Commission)</td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			}
			else if (_error is not null)
			{
				<p class="field-error" role="alert">@_error</p>
			}
		</div>
	</div>
}

<ModalShell IsOpen="@(_editCell is not null)" Title="@_editSetting?.Key" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseEdit" OnSubmit="ApplyEdit">
	<ChildContent>
		@if (_editSetting is { } setting && _editCell is { } cell)
		{
			<p class="hint">@setting.Description</p>
			@if (cell.Note is not null)
			{
				<p class="hint">@cell.Note</p>
			}
			<div class="field">
				<label for="sim-edit-target">@T.Simulator.EditTarget</label>
				<select id="sim-edit-target" value="@_editTarget" @onchange="OnEditTargetChanged">
					@for (var i = 0; i < cell.EditTargets.Length; i++)
					{
						<option value="@i" @key="i">@cell.EditTargets[i].Name</option>
					}
				</select>
			</div>
			<div class="field">
				<label for="sim-edit-value">@T.Pricing.ValueLabel</label>
				<input id="sim-edit-value" type="number" step="0.0001" min="@setting.Min" max="@setting.Max" @bind="_editValue" />
				<span class="hint">@T.Simulator.EditValueHint(T.Pricing.Value(cell.Value), T.Pricing.Value(cell.SavedValue), cell.SavedSource.Name, T.Pricing.Range(setting.Min, setting.Max))</span>
			</div>
			<p class="hint">@T.Simulator.EditScopeHint</p>
			@if (!string.IsNullOrEmpty(_editError))
			{
				<p class="field-error" role="alert">@_editError</p>
			}
		}
	</ChildContent>
	<Footer>
		@if (EditKeyHasOverrides)
		{
			<button type="button" class="btn" @onclick="RemoveKeyOverrides">
				<Icon Name="IconName.Undo" />
				@T.Simulator.RemoveKeyOverrides
			</button>
		}
		<button type="button" class="btn" @onclick="CloseEdit">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="ApplyEdit">@T.Simulator.Substitute</button>
	</Footer>
</ModalShell>

<ModalShell IsOpen="@(_regionEdit is not null)" Title="@RegionEditTitle" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseRegionPrice" OnSubmit="() => ApplyRegionPrice(false)">
	<ChildContent>
		<div class="field">
			<label for="sim-region-min">@T.Simulator.RegionMin</label>
			<input id="sim-region-min" type="number" step="1" min="0" @bind="_regionMin" />
		</div>
		<div class="field">
			<label for="sim-region-max">@T.Simulator.RegionMax</label>
			<input id="sim-region-max" type="number" step="1" min="0" @bind="_regionMax" />
		</div>
		<p class="hint">@T.Simulator.InMemoryHint</p>
		@if (_regionError is not null)
		{
			<p class="field-error" role="alert">@_regionError</p>
		}
	</ChildContent>
	<Footer>
		@if (RegionEditHasOverride)
		{
			<button type="button" class="btn" @onclick="() => ApplyRegionPrice(true)">
				<Icon Name="IconName.Undo" />
				@T.Simulator.RestoreSaved
			</button>
		}
		<button type="button" class="btn" @onclick="CloseRegionPrice">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="() => ApplyRegionPrice(false)">@T.Simulator.Substitute</button>
	</Footer>
</ModalShell>

<ModalShell IsOpen="@(_param is not null)" Title="@ParamTitle" ContainerClass="modal-sm" TopLayer="true" OnClose="@CloseParam" OnSubmit="() => ApplyParam(false)">
	<ChildContent>
		<div class="field">
			<label for="sim-param">@T.Simulator.ParamValueLabel</label>
			@if (_param is ParamKind.MaterialCost)
			{
				<input id="sim-param" type="number" step="0.01" min="0" @bind="_paramValue" />
			}
			else
			{
				<input id="sim-param" type="number" step="0.5" min="-100" max="100" @bind="_paramValue" />
			}
		</div>
		@if (_param is ParamKind.SupplierRebate)
		{
			<p class="hint">@T.Simulator.SupplierRebateHint(T.Pricing.Value(RebateCapture))</p>
		}
		else if (_param is ParamKind.CarrierRebate)
		{
			<p class="hint">@T.Simulator.CarrierRebateHint(T.PriceChart.ModeParts, T.PriceChart.CarrierView)</p>
		}
		@if (_paramError is not null)
		{
			<p class="field-error" role="alert">@_paramError</p>
		}
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="() => ApplyParam(true)">
			<Icon Name="IconName.Undo" />
			@T.Simulator.RestoreSaved
		</button>
		<button type="button" class="btn" @onclick="CloseParam">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="() => ApplyParam(false)">@T.Simulator.Substitute</button>
	</Footer>
</ModalShell>
