@inject ApiClient ApiClient

<ModalShell IsOpen="true" ContainerClass="modal-lg" Title="@T.Vehicles.AddTitle" OnClose="() => OnCancel.InvokeAsync()" OnSubmit="SubmitForm">
	<ChildContent>
		<div class="form-grid">
			<div class="field">
				<label for="vehicle-model">@T.Vehicles.Model</label>
				<input id="vehicle-model" type="text" @bind="_model" placeholder="@T.Vehicles.ModelPlaceholder" />
			</div>

			<div class="field">
				<label for="vehicle-registration">@T.Vehicles.Registration</label>
				<input id="vehicle-registration" type="text" @bind="_registrationNumber" />
			</div>

			<div class="field">
				<label for="vehicle-weight">@T.Vehicles.Weight</label>
				<input id="vehicle-weight" type="number" min="0" @bind="_vehicleWeight" />
			</div>

			<div class="field">
				<label for="vehicle-capacity">@T.Vehicles.Capacity</label>
				<select id="vehicle-capacity" @bind="_loadCapacity">
					<option value="0" disabled>@T.Vehicles.SelectCapacity</option>
					@foreach (var capacity in _capacities)
					{
						<option value="@capacity.WeightKg" @key="capacity.WeightKg">@T.Vehicles.CapacityOption(T.FormatNumber((decimal)capacity.WeightKg, 0))</option>
					}
				</select>
				@if (_capacitiesError is not null)
				{
					<span class="field-error" role="alert">@T.Vehicles.CapacitiesFailed(_capacitiesError)</span>
				}
			</div>

			<div class="field span-all">
				<label for="vehicle-driver">@T.Vehicles.Driver</label>
				<select id="vehicle-driver" @bind="_selectedDriverId">
					<option value="">@T.Vehicles.SelectDriver</option>
					@foreach (var (company, driver) in DriversWithCompany)
					{
						<option value="@driver.Id" @key="driver.Id">@DriverOption(company, driver)</option>
					}
				</select>
			</div>

			<div class="field span-all">
				<label for="vehicle-photo">@T.Vehicles.PhotoUrl</label>
				<input id="vehicle-photo" type="url" @bind="_photo" placeholder="@T.Vehicles.PhotoUrlPlaceholder" />
				@if (!string.IsNullOrEmpty(_photo))
				{
					<img class="photo-preview" src="@_photo" alt="" />
				}
			</div>
		</div>
	</ChildContent>
	<Footer>
		<button type="button" class="btn" @onclick="() => OnCancel.InvokeAsync()">@T.Common.Cancel</button>
		<button type="button" class="btn btn-primary" @onclick="SubmitForm" disabled="@(!IsFormValid())">
			@T.Common.Create
		</button>
	</Footer>
</ModalShell>
