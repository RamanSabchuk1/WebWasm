@using WebWasm.Helpers

<div class="dropdown-actions">
	<button @ref="_triggerRef"
			class="btn-trigger"
			type="button"
			title="@Title"
			@onclick="ToggleAsync">
		⋮
	</button>
	@if (_open)
	{
		<ClickOutside OnClickOutside="Close">
			<div @ref="_menuRef"
				 class="dropdown-menu-content"
				 style="@MenuStyle"
				 @onclick="Close">
				@ChildContent
			</div>
		</ClickOutside>
	}
</div>
