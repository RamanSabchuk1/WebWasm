<div class="card">
	<div class="toolbar">
		<label class="search">
			<Icon Name="IconName.Search" />
			<input type="search" placeholder="@T.Companies.SearchPlaceholder" aria-label="@T.Common.Search"
				   @bind="_searchText" @bind:event="oninput" @bind:after="SaveSearch" />
		</label>
		<div class="segmented type-filter" role="group" aria-label="@T.Companies.TypeFilter">
			<button type="button" aria-pressed="@Aria.State(_companyTypeFilter is null)" @onclick="() => SetTypeFilter(null)">@T.Common.All</button>
			@foreach (var type in FilterTypes)
			{
				<button type="button" aria-pressed="@Aria.State(_companyTypeFilter == type)" @onclick="() => SetTypeFilter(type)" @key="type">
					@T.Enums.CompanyRole(type)
				</button>
			}
		</div>
	</div>

	@{ var filteredRows = FilteredCompanies; }
	@if (filteredRows.Length > 0)
	{
		<div class="table-wrap">
			<QuickGrid ItemsProvider="@GridItems.From(filteredRows)" Pagination="@_pagination" ItemKey="company => company.Id">
				<TemplateColumn Title="@T.Common.Company">
					@{ var expanded = IsExpanded(context.Id); }
					<div class="name-cell">
						<button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => ToggleExpand(context.Id)"
								title="@(expanded ? T.Common.Collapse : T.Common.Expand)" aria-label="@(expanded ? T.Common.Collapse : T.Common.Expand)"
								aria-expanded="@Aria.State(expanded)">
							<Icon Name="@(expanded ? IconName.ChevronDown : IconName.ChevronRight)" />
						</button>
						<div class="name-main">
							<span class="strong">@context.Name</span>
							@if (!string.IsNullOrEmpty(context.CompanyInfo?.UNP))
							{
								<span class="caption tabular">@T.Companies.UnpValue(context.CompanyInfo.UNP)</span>
							}
						</div>
					</div>

					@if (expanded)
					{
						<div class="details">
							<div>
								<h3 class="section-title">@T.Companies.Details</h3>
								<dl class="kv">
									<dt>@T.Common.Address</dt>
									<dd>@OrDash(context.CompanyInfo?.Address)</dd>
									<dt>@T.Companies.CorporateEmail</dt>
									<dd>@OrDash(context.CompanyInfo?.CorporateEmail)</dd>
									<dt>@T.Common.Status</dt>
									<dd><span class="@StatusTone.Of(context.IsActive).Badge()">@(context.IsActive ? T.Companies.Active : T.Companies.Inactive)</span></dd>
									<dt>@T.Companies.Rebate</dt>
									<dd class="tabular">@T.FormatNumber(context.Rebate)</dd>
									@if (context.CompanyInfo is not null)
									{
										<dt>@T.Companies.LegalType</dt>
										<dd>@OrDash(context.CompanyInfo.LegalType)</dd>
										<dt>@T.Companies.Location</dt>
										<dd class="tabular">@T.Companies.Coordinates(T.FormatNumber(context.Location.Latitude, 6), T.FormatNumber(context.Location.Longitude, 6))</dd>
										@if (!string.IsNullOrEmpty(context.CompanyInfo.Photo))
										{
											<dt>@T.Common.Photo</dt>
											<dd><img class="company-photo" src="@context.CompanyInfo.Photo" alt="@context.Name" loading="lazy" /></dd>
										}
									}
								</dl>
							</div>

							@if (context.CompanyInfo?.BankAccount is { } bankAccount)
							{
								<div>
									<h3 class="section-title">@T.Companies.BankAccount</h3>
									<dl class="kv">
										<dt>@T.Companies.BankNumber</dt>
										<dd class="tabular">@bankAccount.BankNumber</dd>
										<dt>@T.Companies.Bic</dt>
										<dd>@bankAccount.BIC</dd>
									</dl>
								</div>
							}
						</div>
					}
				</TemplateColumn>

				<TemplateColumn Title="@T.Common.Email">
					<HeaderTemplate>
						<SortHeader Title="@T.Common.Email" Key="email" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						@if (string.IsNullOrEmpty(context.CompanyInfo?.CorporateEmail))
						{
							<span class="muted">@Texts.Dash</span>
						}
						else
						{
							@context.CompanyInfo.CorporateEmail
						}
					</ChildContent>
				</TemplateColumn>

				<TemplateColumn Title="@T.Common.Type">
					<div class="cluster">
						@foreach (var flag in GetTypeFlags(context.CompanyType))
						{
							<span class="badge badge-neutral" @key="flag">@T.Enums.CompanyRole(flag)</span>
						}
					</div>
				</TemplateColumn>

				<TemplateColumn Title="@T.Common.Created">
					<HeaderTemplate>
						<SortHeader Title="@T.Common.Created" Key="created" State="_sortState" OnSort="CycleSort" />
					</HeaderTemplate>
					<ChildContent>
						@if (context.Created == DateTime.MinValue)
						{
							<span class="muted">@Texts.Dash</span>
						}
						else
						{
							<span class="tabular nowrap">@T.FormatDate(context.Created)</span>
						}
					</ChildContent>
				</TemplateColumn>

				<TemplateColumn Title="@T.Common.Status">
					<span class="@StatusTone.Of(context.IsActive).Badge()">@(context.IsActive ? T.Companies.Active : T.Companies.Inactive)</span>
				</TemplateColumn>

				<TemplateColumn Title="@T.Security.Short">
					<span class="badge badge-neutral">@T.Enums.SecurityLevel(context.SecurityClearanceLevel)</span>
				</TemplateColumn>

				<TemplateColumn Title="@T.Common.Actions" Align="Align.End">
					<ActionsDropdown MenuHeight="170">
						<button type="button" class="menu-item" @onclick="() => OnToggleActive.InvokeAsync((context.Id, !context.IsActive))">
							<Icon Name="@(context.IsActive ? IconName.Ban : IconName.Check)" />
							@(context.IsActive ? T.Companies.Deactivate : T.Companies.Activate)
						</button>
						<button type="button" class="menu-item" @onclick="() => OnEditCompany.InvokeAsync(context)">
							<Icon Name="IconName.Edit" />
							@T.Common.Edit
						</button>
						<button type="button" class="menu-item" @onclick="() => OnEditSecurityLevel.InvokeAsync(context)">
							<Icon Name="IconName.Shield" />
							@T.Security.Short
						</button>
						<div class="menu-separator" role="separator"></div>
						<button type="button" class="menu-item menu-item-danger" @onclick="() => OnDeleteCompany.InvokeAsync(context)">
							<Icon Name="IconName.Delete" />
							@T.Common.Delete
						</button>
					</ActionsDropdown>
				</TemplateColumn>
			</QuickGrid>
		</div>
		<CustomPaginator State="@_pagination" />
	}
	else if (Companies.Count == 0)
	{
		<div class="empty">
			<Icon Name="IconName.Companies" />
			<p class="empty-title">@T.Companies.Empty</p>
			<p class="empty-hint">@T.Companies.EmptyHint</p>
		</div>
	}
	else
	{
		<div class="empty">
			<Icon Name="IconName.Search" />
			<p class="empty-title">@T.Common.NothingFound</p>
			<p class="empty-hint">@T.Common.NothingFoundHint</p>
		</div>
	}
</div>
