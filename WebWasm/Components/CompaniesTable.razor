@using Microsoft.AspNetCore.Components.QuickGrid
@using WebWasm.Models

<div class="data-grid-container">
	<div class="data-grid-toolbar">
		<input type="text"
			   placeholder="Search companies by name, UNP, email, or address..."
			   @bind="_searchText"
			   @bind:after="SaveSearch"
			   @bind:event="oninput"
			   class="search-input" />

		<button class="filter-toggle-btn" @onclick="() => _showFilters = !_showFilters">
			<span>🔍 Filters</span>
			@if (_companyTypeFilter != null)
			{
				<span class="filter-count-badge">1</span>
			}
			<span class="filter-toggle-icon">@(_showFilters ? "▲" : "▼")</span>
		</button>
	</div>

	@if (_showFilters)
	{
		<div class="filters-panel">
			<div class="filter-row">
				<label class="filter-label">Company Type</label>
				<div class="filter-control">
					<div class="kind-switch">
						<button type="button"
								class="kind-switch-btn @(_companyTypeFilter == null ? "active" : "")"
								@onclick="() => SetTypeFilter(null)">
							All
						</button>
						<button type="button"
								class="kind-switch-btn @(_companyTypeFilter == CompanyType.Buyer ? "active" : "")"
								@onclick="() => SetTypeFilter(CompanyType.Buyer)">
							Buyer
						</button>
						<button type="button"
								class="kind-switch-btn @(_companyTypeFilter == CompanyType.Cargo ? "active" : "")"
								@onclick="() => SetTypeFilter(CompanyType.Cargo)">
							Cargo
						</button>
						<button type="button"
								class="kind-switch-btn @(_companyTypeFilter == CompanyType.Provider ? "active" : "")"
								@onclick="() => SetTypeFilter(CompanyType.Provider)">
							Provider
						</button>
					</div>
				</div>
			</div>
		</div>
	}

	@if (_hasItems)
	{
		<div class="data-grid-scroll">
			<QuickGrid Items="@FilteredCompanies" Pagination="@_pagination" class="data-grid">
				<TemplateColumn Title="Company" Sortable="false">
					<div class="company-cell">
						<button class="btn-expand" @onclick="() => ToggleExpand(context.Id)">
							@(IsExpanded(context.Id) ? "▼" : "▶")
						</button>
						<div class="company-info">
							<div class="company-name">@context.Name</div>
							<div class="company-unp">UNP: @context.CompanyInfo?.UNP</div>
						</div>
					</div>

					@if (IsExpanded(context.Id))
					{
						<div class="company-expanded">
							<!-- Basic Info Section -->
							<div class="info-section">
								<h4>Company Information</h4>
								<div class="info-grid">
									<div class="info-item">
										<span class="info-label">Address:</span>
										<span class="info-value">@context.CompanyInfo?.Address</span>
									</div>
									<div class="info-item">
										<span class="info-label">Corporate Email:</span>
										<span class="info-value">@context.CompanyInfo?.CorporateEmail</span>
									</div>
									<div class="info-item">
										<span class="info-label">Status:</span>
										<span class="info-value">
											@if (context.IsActive)
											{
												<span class="badge badge-active">Active</span>
											}
											else
											{
												<span class="badge badge-inactive">Inactive</span>
											}
										</span>
									</div>
									<div class="info-item">
										<span class="info-label">Rebate:</span>
										<span class="info-value">@context.Rebate</span>
									</div>
								</div>
							</div>

							<!-- Company Info Section -->
							@if (context.CompanyInfo is not null)
							{
								<div class="info-section">
									<h4>Operational Details</h4>
									<div class="info-grid">
										<div class="info-item">
											<span class="info-label">Legal Type:</span>
											<span class="info-value">@context.CompanyInfo.LegalType</span>
										</div>
										<div class="info-item">
											<span class="info-label">Location:</span>
											<span class="info-value location">
												📍 @context.Location.Latitude.ToString("F6"), @context.Location.Longitude.ToString("F6")
											</span>
										</div>
										@if (!string.IsNullOrEmpty(context.CompanyInfo.Photo))
										{
											<div class="info-item full-width">
												<span class="info-label">Photo:</span>
												<div class="company-photo">
													<img src="@context.CompanyInfo.Photo" alt="@context.Name" />
												</div>
											</div>
										}
									</div>
								</div>

								<!-- Bank Account Section -->
								@if (context.CompanyInfo.BankAccount is not null)
								{
									<div class="info-section">
										<h4>Bank Account</h4>
										<div class="info-grid">
											<div class="info-item">
												<span class="info-label">Bank Number:</span>
												<span class="info-value bank-number">@context.CompanyInfo.BankAccount.BankNumber</span>
											</div>
											<div class="info-item">
												<span class="info-label">BIC:</span>
												<span class="info-value">@context.CompanyInfo.BankAccount.BIC</span>
											</div>
										</div>
									</div>
								}
							}
						</div>
					}
				</TemplateColumn>

				<TemplateColumn Title="Email" Sortable="false">
					<HeaderTemplate>
						<button class="@SortHelper.GetHeaderClass(_sortState, "email")" @onclick='() => CycleSort("email")'>
							Email <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "email")</span>
						</button>
					</HeaderTemplate>
					<ChildContent>
						@(context.CompanyInfo?.CorporateEmail ?? "")
					</ChildContent>
				</TemplateColumn>

				<TemplateColumn Title="Type" Sortable="false">
					@foreach (var flag in GetTypeFlags(context.CompanyType))
					{
						<span class="type-badge type-badge--@flag.ToString().ToLowerInvariant()">@flag</span>
					}
				</TemplateColumn>

				<TemplateColumn Title="Created" Sortable="false">
					<HeaderTemplate>
						<button class="@SortHelper.GetHeaderClass(_sortState, "created")" @onclick='() => CycleSort("created")'>
							Created <span class="sort-indicator">@SortHelper.GetIndicator(_sortState, "created")</span>
						</button>
					</HeaderTemplate>
					<ChildContent>
						@FormatCreated(context.Created)
					</ChildContent>
				</TemplateColumn>

				<TemplateColumn Title="Status" Sortable="false">
					@if (context.IsActive)
					{
						<span class="status-badge status-active">Active</span>
					}
					else
					{
						<span class="status-badge status-inactive">Inactive</span>
					}
				</TemplateColumn>

				<TemplateColumn Title="Security Level" Sortable="false">
					@{
						var clearance = context.SecurityClearanceLevel;
					}
					<span class="level-badge level-badge--@clearance.ToString().ToLowerInvariant()">@clearance</span>
				</TemplateColumn>

				<TemplateColumn Title="Actions" Sortable="false">
					<ActionsDropdown Title="Действия" MenuHeight="180">
						<button class="btn-action" @onclick="() => OnToggleActive.InvokeAsync((context.Id, !context.IsActive))">
							@(context.IsActive ? "🚫 Deactivate" : "✅ Activate")
						</button>
						<button class="btn-action" @onclick="() => OnEditCompany.InvokeAsync(context)">
							✏️ Edit
						</button>
						<button class="btn-action" @onclick="() => OnEditSecurityLevel.InvokeAsync(context)" title="View or change data security level for this company">
							🔐 Security
						</button>
						<button class="btn-action" @onclick="() => OnDeleteCompany.InvokeAsync(context)" title="Soft delete company (cascades to producers, vehicles, drivers, users)">
							🗑️ Delete
						</button>
					</ActionsDropdown>
				</TemplateColumn>
			</QuickGrid>
		</div>

		<div class="data-grid-pagination">
			<CustomPaginator State="@_pagination" />
		</div>
	}
	else
	{
		<div class="empty-state">
			<p>No companies available</p>
		</div>
	}
</div>
